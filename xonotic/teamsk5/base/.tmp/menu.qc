void CampaignSetup(float n)
{
 cmd("set g_campaign 1\n");
 cmd("set _campaign_name \"");
  cmd(campaign_name);
  cmd("\"\n");
 cmd("set _campaign_index ");
  cmd(ftos(campaign_offset + n));
  cmd("\n");
 cmd("disconnect\nmaxplayers 16\n");
 MapInfo_LoadMap(campaign_mapname[n], 1);

 makeServerSingleplayer();

}

