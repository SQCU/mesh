float CREDITS_TYPE_TITLE = 2;
float CREDITS_TYPE_FUNCTION = 1;
float CREDITS_TYPE_PERSON = 0;
float CREDITS_TYPE_NL = -1;
void credits_add_line(float fh, float n, float type, string line)
{
 if (type == CREDITS_TYPE_TITLE)
  line = strcat("**", line);
 else if (type == CREDITS_TYPE_FUNCTION)
  line = strcat("*", line);

 if (fh >= 0)
  fputs(fh, strcat(line, "\n"));
 if (n >= 0)
  bufstr_add(n, line, 0);
}

