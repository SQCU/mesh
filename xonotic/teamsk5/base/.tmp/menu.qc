  f = random() * 6;

  for(i = 0; i < n; ++i)
  {
   c = substring(s, i, 1);

   if(c == ";")
    c = ":";
   else if(c == "^")
   {
    c = "^^";
    if(substring(s, i+1, 1) == "^")
     ++i;
   }

   if(c != " ")
