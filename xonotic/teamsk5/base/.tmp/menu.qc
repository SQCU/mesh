[[eraseable]]
void RegisterCvars_Set(string name, string def, string desc, float archive, string file)
{
 cmd(sprintf("\nset %1$s \"$%1$s\" \"%2$s\"\n", name, MakeConsoleSafe(desc)));
 if (archive)
  cmd(sprintf("\nseta %1$s \"$%1$s\"\n", name));
}

float RegisterCvars_Save_fd;
[[eraseable]]
void RegisterCvars_Save(string name, string def, string desc, float archive, string file)
{
 if (!archive) return;
 fputs(RegisterCvars_Save_fd, sprintf("seta %s \"%s\"\n", name, def));
}

