float _MapInfo_Generate(string pFilename)
{
 string fn;
 float fh;
 string s, k, v;
 vector o;
 float i;
 float inWorldspawn;
 float r;
 float diameter, spawnpoints;
 float spawnplaces;
 float is_q3df_map = false;

 vector mapMins, mapMaxs;

 r = 1;
 fn = strcat("maps/", pFilename, ".ent");
 fh = fopen(fn, FILE_READ);
 if(fh < 0)
 {
  r = 2;
  fn = strcat("maps/", pFilename, ".bsp");
  fh = fopen(fn, FILE_READ);
 }
 if(fh < 0)
  return 0;
 if(1){ if (autocvar_developer > 1) dprint(strcat1n("^9[::^7""MENUQC""^9::""^5INFO""^9] ", (sprintf("^7%s^9(^9%s^7:^9%s^7)", __FUNC__, "./common/mapinfo.qc", "291")), "\n")); string __s = strcat1n("Analyzing ", fn, " to generate initial mapinfo"); print("^7", __s); if (_str2chr(__s, strlen(__s) - 1) != '\n') { print("\n"); } }else voidfunc();

 inWorldspawn = 2;
 MapInfo_Map_flags = 0;
 MapInfo_Map_supportedGametypes = 0;
 spawnpoints = 0;
 spawnplaces = 0;
 _MapInfo_Map_worldspawn_music = "";
 mapMins = '0 0 0';
 mapMaxs = '0 0 0';

 if(autocvar_g_mapinfo_q3compat == 2)
 {

  float isdefi = false;
  float arena_fh = -1;
  string arena_fn = _MapInfo_FindArenaFile(pFilename, ".arena");
  if(arena_fn != "")
   arena_fh = fopen(arena_fn, FILE_READ);
  if(arena_fh < 0)
  {
   isdefi = true;
   arena_fn = _MapInfo_FindArenaFile(pFilename, ".defi");
   if(arena_fn != "")
    arena_fh = fopen(arena_fn, FILE_READ);
  }
  if(arena_fh >= 0)
  {
   _MapInfo_ParseArena(arena_fn, arena_fh, pFilename, (0, null_entity), isdefi, true);
   fclose(arena_fh);
  }
 }

 for (;;)
 {
  if (!((s = fgets(fh))))
   break;
  if(inWorldspawn == 1)
   if((_strstrofs(s, "}", 0) == 0))
    inWorldspawn = 0;
  k = unquote(car(s));
  v = unquote(cdr(s));
  if(inWorldspawn)
  {
   if(k == "classname" && v == "worldspawn")
    inWorldspawn = 1;
   else if(k == "author")
    MapInfo_Map_author = v;
   else if(k == "_description")
    MapInfo_Map_description = v;
   else if(k == "music")
    _MapInfo_Map_worldspawn_music = v;
   else if(k == "noise")
    _MapInfo_Map_worldspawn_music = v;
