  setDependent(e, "r_drawviewmodel", 1, 1);
 me.TR(me);
  me.TDempty(me, 0.2);
  me.TD(me, 1, 2.8, e = makeXonoticCheckBox(0, "cl_bobmodel", _("Gun model bobbing")));
  setDependent(e, "r_drawviewmodel", 1, 1);
