  me.startSound(me, 0);
  return 1;
 }
 else if(scan == K_SPACE) {
  me.pauseSound(me);
  return 1;
 }
 else if(scan == K_DEL || scan == K_KP_DEL || scan == K_BACKSPACE || scan == K_MOUSE3) {
  me.removeSelectedFromPlayList(me);
  return 1;
 }
 else
  return (XonoticPlayList_vtbl.vtblbase).keyDown(me, scan, ascii, shift);
}

