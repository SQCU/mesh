void XonoticParticlesSlider_configureXonoticParticlesSlider(entity me)
{
 me.configureXonoticTextSlider(me, "cl_particles_quality",
  _("Multiplier for amount of particles. Less means less particles, which in turn gives for better performance"));
 if(cvar("developer") > 0) { me.addValue(me, strzone(CTX(_("PART^OMG"))), "0.25 250 0"); }
 me.addValue(me, strzone(CTX(_("PARTQUAL^Low"))), "0.5 500 0");
 me.addValue(me, strzone(CTX(_("PARTQUAL^Medium"))), "0.75 750 0");
 me.addValue(me, strzone(CTX(_("PARTQUAL^Normal"))), "1.0 1000 1");
 me.addValue(me, strzone(CTX(_("PARTQUAL^High"))), "1.5 1500 1");
 me.addValue(me, strzone(CTX(_("PARTQUAL^Ultra"))), "2.0 2000 2");
 if(cvar("developer") > 0) { me.addValue(me, strzone(CTX(_("PARTQUAL^Ultimate"))), "3.0 3000 2"); }
 me.configureXonoticTextSliderValues(me);
}
