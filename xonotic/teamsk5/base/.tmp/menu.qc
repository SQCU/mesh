 drawfontscale.x *= f;
 vector fs = me.realFontSize;
 fs.x *= f;
 draw_Text(me.realUpperMargin * eY, msg, fs, SKINCOLOR_TEXT, SKINALPHA_TEXT, 0);
 drawfontscale = save_fontscale;
}

