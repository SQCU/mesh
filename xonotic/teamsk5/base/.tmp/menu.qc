 me.gotoRC(me, me.rows - 1, 0);
 me.TD(me, 1, me.columns, e = makeXonoticCommandButton(_("Save settings"), '0 0 0', "prvm_language \"$_menu_prvm_language\"; saveconfig; menu_restart", 2));
  setDependentWeird(e, CheckFirstRunButton);
}

