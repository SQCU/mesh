.string message;

void MX_Nick_(entity fh, entity pass, float status);
void MX_Nick(string name)
{
    if (!matrix_access_token) return;
    entity pass = __spawn("mx", "./lib/matrix/matrix.qc" ":" "9", true);
    pass.message = name;
    url_single_fopen(
        sprintf("%s/_matrix/client/r0/profile/%s/displayname?access_token=%s", autocvar_matrix_server, matrix_user, matrix_access_token),
        FILE_WRITE,
        MX_Nick_,
        pass
    );
}
void MX_Nick_(entity fh, entity pass, float status)
{
    switch (status) {
        case URL_READY_CANWRITE: {
            fh.url_verb = "PUT";
            fh.url_content_type = "application/json";
            url_fputs(fh, sprintf("{\"displayname\": \"%s\"}", pass.message));
            if(1){ entity _this = (pass); void(entity) _dtor = _this.dtor; ONREMOVE(pass); if (_dtor) _dtor(_this); else builtin_remove(_this); }else voidfunc();
            url_fclose(fh);
            break;
        }
    }
}


void MX_Messages_(entity fh, entity pass, float status);
void MX_Messages(string from)
{
    if (!matrix_access_token) return;
    string s = sprintf("%s/_matrix/client/r0/events?room_id=%s&limit=50&timeout=30000&from=%s&access_token=%s", autocvar_matrix_server, matrix_room, from, matrix_access_token);
    url_single_fopen(
        s,
        FILE_READ,
        MX_Messages_,
        (0, null_entity)
    );
}
