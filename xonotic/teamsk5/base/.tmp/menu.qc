void XonoticMapInfoDialog_loadMapInfo(entity me, float i, entity mlb)
{
 me.currentMapIndex = i;
 me.startButton.onClickEntity = mlb;
 MapInfo_Get_ByID(i);

 if(1){ if (me.currentMapBSPName) { strunzone(me.currentMapBSPName); } me.currentMapBSPName = strzone(MapInfo_Map_bspname); }else voidfunc();
 if(1){ if (me.currentMapTitle) { strunzone(me.currentMapTitle); } me.currentMapTitle = strzone(strdecolorize(MapInfo_Map_title)); }else voidfunc();
 if(1){ if (me.currentMapAuthor) { strunzone(me.currentMapAuthor); } me.currentMapAuthor = strzone(strdecolorize(MapInfo_Map_author)); }else voidfunc();
 if(1){ if (me.currentMapDescription) { strunzone(me.currentMapDescription); } me.currentMapDescription = strzone(MapInfo_Map_description); }else voidfunc();
 if(1){ if (me.currentMapPreviewImage) { strunzone(me.currentMapPreviewImage); } me.currentMapPreviewImage = strzone(strcat("/maps/", MapInfo_Map_bspname)); }else voidfunc();
 if(!draw_PictureExists(me.currentMapPreviewImage))
  if(1){ if (me.currentMapPreviewImage) { strunzone(me.currentMapPreviewImage); } me.currentMapPreviewImage = strzone(strcat("/levelshots/", MapInfo_Map_bspname)); }else voidfunc();

 me.frame.setText(me.frame, me.currentMapBSPName);
 me.titleLabel.setText(me.titleLabel, me.currentMapTitle);
 me.authorLabel.setText(me.authorLabel, me.currentMapAuthor);
 me.descriptionLabel.setText(me.descriptionLabel, me.currentMapDescription);
 if(!draw_PictureExists(me.currentMapPreviewImage))
  me.previewImage.src = "nopreview_map";
 else
  me.previewImage.src = me.currentMapPreviewImage;

 for(i = 0; i < GameType_GetTotalCount(); ++i)
 {
  entity e;
  e = me.(typeLabels[i]);
  e.disabled = !(MapInfo_Map_supportedGametypes & GameType_GetID(i).m_flags);
 }

 MapInfo_ClearTemps();
}
