entity RetrieveCategoryEnt(float catnum)
{
 if((catnum > 0) && (catnum <= category_ent_count))
 {
  return categories[catnum - 1];
 }
 else
 {
  (__self = ((0, null_entity)), builtin_error(sprintf("RetrieveCategoryEnt(%d): Improper category number!\n", catnum)));
  return (0, null_entity);
 }
}

float IsServerInList(string list, string srv)
{
 if(srv == "")
  return false;
 srv = netaddress_resolve(srv, 26000);
 if(srv == "")
  return false;
 string p = crypto_getidfp(srv);
 float n = tokenize_console(list);
 for(float i = 0; i < n; ++i)
 {
  if(substring(argv(i), 0, 1) != "[" && strlen(argv(i)) == 44 && _strstrofs(argv(i), ".", 0) < 0)
  {
   if(p && argv(i) == p)
    return true;
  }
  else
  {
   if(srv == netaddress_resolve(argv(i), 26000))
    return true;
  }
 }
 return false;
}

float CategoryOverride(float cat)
{
 entity catent = RetrieveCategoryEnt(cat);
 if(catent)
 {
  float override = (autocvar_menu_slist_categories ? catent.cat_enoverride : catent.cat_dioverride);
  if(override) { return override; }
  else { return cat; }
 }
 else
 {
  (__self = ((0, null_entity)), builtin_error(sprintf("CategoryOverride(%d): Improper category number!\n", cat)));
  return cat;
 }
}

float CategoryForEntry(float entry)
{
 string s, k, v, modtype = "";
 float j, m, impure = 0, freeslots = 0, sflags = 0;
 s = gethostcachestring(SLIST_FIELD_QCSTATUS, entry);
 m = tokenizebyseparator(s, ":");

 for(j = 2; j < m; ++j)
 {
  if(argv(j) == "") { break; }
  k = substring(argv(j), 0, 1);
  v = substring(argv(j), 1, -1);
  switch(k)
  {
   case "P": { impure = stof(v); break; }
   case "S": { freeslots = stof(v); break; }
   case "F": { sflags = stof(v); break; }
   case "M": { modtype = strtolower(v); break; }
  }
 }

 if(modtype != "xonotic") { impure += autocvar_menu_slist_modimpurity; }


 if(gethostcachenumber(SLIST_FIELD_ISFAVORITE, entry)) { return CAT_FAVORITED; }


 if(autocvar_menu_slist_recommendations)
 {
  string cname = gethostcachestring(SLIST_FIELD_CNAME, entry);

  if(IsServerInList(_Nex_ExtResponseSystem_PromotedServers, cname)) { return CAT_RECOMMENDED; }
  else
  {
   float recommended = 0;
   if(autocvar_menu_slist_recommendations & 1)
   {
    if(IsServerInList(_Nex_ExtResponseSystem_RecommendedServers, cname)) { ++recommended; }
    else { --recommended; }
   }
   if(autocvar_menu_slist_recommendations & 2)
   {
    if(

     (freeslots >= autocvar_menu_slist_recommendations_minfreeslots)

     &&
     (
      (autocvar_menu_slist_recommendations_purethreshold < 0)
      ||
      (impure <= autocvar_menu_slist_recommendations_purethreshold)
     )

     &&
     (
      gethostcachenumber(SLIST_FIELD_NUMHUMANS, entry)
      >=
      autocvar_menu_slist_recommendations_minhumans
     )

     &&
     (
      gethostcachenumber(SLIST_FIELD_PING, entry)
      <=
      autocvar_menu_slist_recommendations_maxping
     )
    )
     { ++recommended; }
    else
     { --recommended; }
   }
   if(recommended > 0) { return CAT_RECOMMENDED; }
  }
 }


 if(modtype != "xonotic")
 {
  switch(modtype)
  {

   case "": { return CAT_MODIFIED; }

   case "xpm": { return CAT_XPM; }
   case "minstagib":
   case "instagib": { return CAT_INSTAGIB; }
   case "overkill": { return CAT_OVERKILL; }


   case "cts":
   case "xdf": { return CAT_DEFRAG; }

   default: { if(1){ if (autocvar_developer > 0) dprint(strcat1n("^9[::^7""MENUQC""^9::""^6TRACE""^9] ", (sprintf("^7%s^9(^9%s^7:^9%s^7)", __FUNC__, "./menu/xonotic/serverlist.qc", "209")), "\n")); dprint(strcat1n("^7", sprintf("Found strange mod type: %s", modtype), "\n")); }else voidfunc(); return CAT_MODIFIED; }
  }
 }


 return ((impure > autocvar_menu_slist_purethreshold) ? CAT_MODIFIED : CAT_NORMAL);
}

void(XonoticServerList this, string srv) XonoticServerList_toggleFavorite; .void(XonoticServerList this, string srv) toggleFavorite; [[accumulate]] void spawnXonoticServerList_static(XonoticServerList this) { this.toggleFavorite = XonoticServerList_toggleFavorite; } void(XonoticServerList this, string srv) XonoticServerList_toggleFavorite
{
 float adding = true;
 string srv_resolved = netaddress_resolve(srv, 26000);
 string p = crypto_getidfp(srv_resolved);
 string s = cvar_string("net_slist_favorites");
 string ret = s;
 for (float i = 0, n = tokenize_console(s); i < n; ++i)
 {
  float match;
  if (substring(argv(i), 0, 1) != "[" && strlen(argv(i)) == 44 && _strstrofs(argv(i), ".", 0) < 0)
  {

   match = (p && p == argv(i));
  }
  else
  {

   match = (srv_resolved == netaddress_resolve(argv(i), 26000));
  }
  if (!match) continue;

  adding = false;
  string before = (i > 0) ? substring(s, 0, argv_end_index(i - 1)) : "";
  string after = (i < n - 1) ? substring(s, argv_start_index(i + 1), -1) : "";
  s = strcat(before, (before != "" && after != "" ? " " : ""), after);
  ret = s;


  n = tokenize_console(s);
  --i;
 }
 if (adding)
 {
  ret = strcat(s, (s != "" ? " " : ""), p ? p : srv);
 }
 cvar_set("net_slist_favorites", ret);
 this.refreshServerList(this, REFRESHSERVERLIST_RESORT);
}

void ServerList_Update_favoriteButton(entity btn, entity me)
{
 entity e = me.favoriteButton;
 if(IsServerInList(cvar_string("net_slist_favorites"), me.ipAddressBox.text))
 {
  e.setText(e, strzone(CTX(_("SERVER^Remove favorite"))));
  setZonedTooltip(e, _("Remove the currently highlighted server from bookmarks"), nil);
 }
 else
 {
  e.setText(e, strzone(CTX(_("SERVER^Favorite"))));
  setZonedTooltip(e, _("Bookmark the currently highlighted server so that it's faster to find in the future"), nil);
 }
}

