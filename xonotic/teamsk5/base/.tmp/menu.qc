void wordwrap_cb(string s, float l, void(string) callback)
{
 string c;
 float lleft, i, j, wlen;

 s = strzone(s);
 lleft = l;
 float len = strlen(s);
 for (i = 0; i < len; ++i)
 {
  if (substring(s, i, 2) == "\\n")
  {
   callback("\n");
   lleft = l;
   ++i;
  }
  else if (substring(s, i, 1) == "\n")
  {
   callback("\n");
   lleft = l;
  }
  else if (substring(s, i, 1) == " ")
  {
   if (lleft > 0)
   {
    callback(" ");
    --lleft;
   }
  }
  else
  {
   for (j = i+1; j < len; ++j)







   {
    c = substring(s, j, 1);
    if (c == " ")
     break;
    if (c == "\\")
     break;
    if (c == "\n")
     break;



    callback("");
   }
   wlen = j - i;
   if (lleft < wlen)
   {
    callback("\n");
    lleft = l;
   }
   callback(substring(s, i, wlen));
   lleft -= wlen;
   i = j - 1;
  }
 }
 strunzone(s);
}

void depthfirst(entity start, .entity up, .entity downleft, .entity right, void(entity, entity) funcPre, void(entity, entity) funcPost, entity pass)
{
 entity e;
 e = start;
 funcPre(pass, e);
 while (e.(downleft))
 {
  e = e.(downleft);
  funcPre(pass, e);
 }
 funcPost(pass, e);
 while(e != start)
 {
  if (e.(right))
  {
   e = e.(right);
   funcPre(pass, e);
   while (e.(downleft))
   {
    e = e.(downleft);
    funcPre(pass, e);
   }
  }
  else
   e = e.(up);
  funcPost(pass, e);
 }
}

