            break;
        }
    }
}


void MX_Sync_(entity fh, entity pass, float status);
void MX_Sync(string since)
{
    if (!matrix_access_token) return;
    string s = strcat(autocvar_matrix_server, "/_matrix/client/r0/sync?");
    if (since) {
        s = strcat(s,
            "since=", since, "&",
            "timeout=30000&",
            sprintf("filter={\"account_data\":{\"types\":[]},\"presence\":{\"types\":[]},\"room\":{\"rooms\":[\"%s\"]}}&", matrix_room)
        );
    } else {
        s = strcat(s,
            "timeout=0&",
            "filter={\"account_data\":{\"types\":[]},\"presence\":{\"types\":[]},\"room\":{\"rooms\":[]}}&"
        );
    }
    s = strcat(s, "access_token=", matrix_access_token);
    url_single_fopen(s, FILE_READ, MX_Sync_, (0, null_entity));
}
void MX_Sync_(entity fh, entity pass, float status)
{
    switch (status) {
        default: {
            if(1){ if (autocvar_developer > 0) print(strcat1n("^9[::^7""MENUQC""^9::""^3WARNING""^9] ", (sprintf("^7%s^9(^9%s^7:^9%s^7)", __FUNC__, "./lib/matrix/matrix.qc", "93")), "\n")); print(strcat1n("^7", sprintf("status: %d", status), "\n")); }else voidfunc();
            break;
        }
        case URL_READY_CLOSED: break;
        case URL_READY_CANREAD: {
            string json = "";
            for (string s; (s = url_fgets(fh)); ) { json = strcat(json, s, "\n"); }
            url_fclose(fh);
            float buf = json_parse(json, _json_parse_object);
            if(1){ float expected = true; float actual = (-1) != (buf); if ((expected) != (actual)) { if(1){ ++TEST_failed; if(1){ if (autocvar_developer > 0) print(strcat1n("^9[::^7""MENUQC""^9::""^3WARNING""^9] ", (sprintf("^7%s^9(^9%s^7:^9%s^7)", __FUNC__, "./lib/matrix/matrix.qc", "102")), "\n")); print(strcat1n("^7", strcat1n(sprintf( "Value of: " "(-1) != (buf)" "\n" "  Actual: %d\n" "Expected: %d\n", actual, expected )), "\n")); }else voidfunc(); }else voidfunc(); } }else voidfunc();
            string arr = sprintf("rooms.join.%s.timeline.events", matrix_room);
            for (float i = 0, n = stof(json_get(buf, sprintf("%s.length", arr))); i < n; ++i) {
                MX_Handle(buf, sprintf("%s.%d", arr, i));
            }
            MX_Sync(json_get(buf, "next_batch"));
            break;
        }
    }
}


void MX_JLF_(entity fh, entity pass, float status);
