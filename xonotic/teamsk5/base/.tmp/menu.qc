void _MapInfo_Map_ApplyGametypeEx(string s, Gametype pWantedType, Gametype pThisType)
{
 MapInfo_Map_supportedGametypes |= pThisType.m_flags;
 if (!(pThisType.m_flags & pWantedType.m_flags))
  return;



 cvar_set("timelimit", cvar_defstring("timelimit"));
 cvar_set("leadlimit", cvar_defstring("leadlimit"));
 cvar_set("fraglimit", cvar_defstring("fraglimit"));
 if(1){ float _i = 0; for (entity _it = Gametypes_first, _next = (0, null_entity); _it; (_it = _next, ++_i)) { const noref float i = _i; const noref entity it = _it; _next = _it.enemy; if (true) { { it.m_parse_mapinfo(nil, nil); } } } }else voidfunc();

 string fraglimit_normal = nil;
 string fraglimit_teams = nil;

 for (s = strcat(_MapInfo_GetDefaultEx(pWantedType), " ", s); s != ""; s = cdr(s)) {
  string sa = car(s);
  if (sa == "") continue;
  float p = _strstrofs(sa, "=", 0);
  if (p < 0) {
   if(false)
    if(1){ if (autocvar_developer > 0) print(strcat1n("^9[::^7""MENUQC""^9::""^3WARNING""^9] ", (sprintf("^7%s^9(^9%s^7:^9%s^7)", __FUNC__, "./common/mapinfo.qc", "561")), "\n")); print(strcat1n("^7", sprintf("Invalid gametype setting in mapinfo for gametype %s: %s", MapInfo_Type_ToString(pWantedType), sa), "\n")); }else voidfunc();
   continue;
  }
  string k = substring(sa, 0, p);
  string v = substring(sa, p + 1, -1);
  float handled = true;
  switch (k) {
   case "timelimit":
   {
    cvar_set("timelimit", v);
    break;
   }
   case "leadlimit":
   {
    cvar_set("leadlimit", v);
    break;
   }
   case "pointlimit":
   case "fraglimit":
   case "lives":
   case "laplimit":
   case "caplimit":
   {
    fraglimit_normal = v;
    break;
   }
   case "teampointlimit":
   case "teamlaplimit":
   {
    fraglimit_teams = v;
    break;
   }
   default:
   {
       handled = false;
       break;
   }
  }
  if(1){ float _i = 0; for (entity _it = Gametypes_first, _next = (0, null_entity); _it; (_it = _next, ++_i)) { const noref float i = _i; const noref entity it = _it; _next = _it.enemy; if (true) { { handled |= it.m_parse_mapinfo(k, v); } } } }else voidfunc();
  if (!handled && false)
            if(1){ if (autocvar_developer > 0) print(strcat1n("^9[::^7""MENUQC""^9::""^3WARNING""^9] ", (sprintf("^7%s^9(^9%s^7:^9%s^7)", __FUNC__, "./common/mapinfo.qc", "601")), "\n")); print(strcat1n("^7", sprintf("Invalid gametype setting in mapinfo for gametype %s: %s", MapInfo_Type_ToString(pWantedType), sa), "\n")); }else voidfunc();
 }

 if (pWantedType == MAPINFO_TYPE_RACE && cvar("g_race_teams") >= 2)
 {
  if(fraglimit_teams)
   cvar_set("fraglimit", fraglimit_teams);
 }
 else
 {
  if(fraglimit_normal)
   cvar_set("fraglimit", fraglimit_normal);
 }
}

Gametype MapInfo_Type_FromString(string gtype, float dowarn, float is_q3compat)
{
 string replacement = "";
 float do_warn = true;
 switch (gtype)
 {
  case "nexball": replacement = "nb"; break;
  case "freezetag": replacement = "ft"; break;
  case "keepaway": replacement = "ka"; break;
  case "invasion": replacement = "inv"; break;
  case "assault": replacement = "as"; break;
  case "race": replacement = "rc"; break;

  case "ffa": replacement = "dm"; do_warn = false; break;
  case "cctf":
  case "oneflag": replacement = "ctf"; do_warn = false; break;
  case "tournament":
  case "tourney": replacement = "duel"; do_warn = false; break;
  case "arena": if(is_q3compat) { replacement = "ca"; do_warn = false; } break;
 }
 if (replacement != "")
 {
  if (dowarn && false)
   if(1){ if (autocvar_developer > 0) print(strcat1n("^9[::^7""MENUQC""^9::""^3WARNING""^9] ", (sprintf("^7%s^9(^9%s^7:^9%s^7)", __FUNC__, "./common/mapinfo.qc", "639")), "\n")); print(strcat1n("^7", sprintf("MapInfo_Type_FromString (probably %s): using deprecated name '%s'. Should use '%s'.", MapInfo_Map_bspname, gtype, replacement), "\n")); }else voidfunc();
  gtype = replacement;
 }
 if(1){ float _i = 0; for (entity _it = Gametypes_first, _next = (0, null_entity); _it; (_it = _next, ++_i)) { const noref float i = _i; const noref entity it = _it; _next = _it.enemy; if (it.mdl == gtype) { { return it; } } } }else voidfunc();
 return (0, null_entity);
}

