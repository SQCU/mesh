{
 if(1){ float _i = 0; for (entity _it = Gametypes_first, _next = (0, null_entity); _it; (_it = _next, ++_i)) { const noref float i = _i; const noref entity it = _it; _next = _it.enemy; if (true) { { cvar_set(it.netname, (it == t) ? "1" : "0"); } } } }else voidfunc();
}

