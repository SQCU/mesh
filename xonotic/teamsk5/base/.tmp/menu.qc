entity makeXonoticSoundList()
{
 entity me;
 me = spawnXonoticSoundList_1(__spawn("XonoticSoundList", "./menu/xonotic/soundlist.qc" ":" "9", true));
 me.configureXonoticSoundList(me);
 return me;
