{
 MapInfo_Map_supportedGametypes = 0;







 if(1){ if (autocvar_developer > 1) dprint(strcat1n("^9[::^7""MENUQC""^9::""^5INFO""^9] ", (sprintf("^7%s^9(^9%s^7:^9%s^7)", __FUNC__, "./common/mapinfo.qc", "1468")), "\n")); string __s = strcat1n("Switching to map ", s); print("^7", __s); if (_str2chr(__s, strlen(__s) - 1) != '\n') { print("\n"); } }else voidfunc();

