  {
   me.dragScrollPos = pos;
   p = me.scrollPos + pos.x - me.keepspaceLeft;
   me.cursorPos = draw_TextLengthUpToWidth(me.text, p, 0, me.realFontSize);
   me.lastChangeTime = time;
  }
  else if (me.enableClearButton)
  {
   if (over_ClearButton(me, pos))
   {
    me.cb_pressed = 1;
    return 1;
   }
  }
  me.cb_pressed = 0;
  return 1;
 }

