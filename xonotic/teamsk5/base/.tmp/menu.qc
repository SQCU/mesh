float Item_ItemsTime_SpectatorOnly(GameItem it)
{
    return (false
    || it == ITEM_ArmorMega || (it == ITEM_ArmorBig && !false)
    || it == ITEM_HealthMega || (it == ITEM_HealthBig && !false)
    );
}

float Item_ItemsTime_Allow(GameItem it)
{
    return (false
    || it.instanceOfPowerup
    || Item_ItemsTime_SpectatorOnly(it)
    );
}

