void XonoticServerList_setSelected(entity me, float i)
{
 me.lockedSelectedItem = false;

 (XonoticServerList_vtbl.vtblbase).setSelected(me, i);




 if(me.nItems == 0)
  return;
 if(gethostcachevalue(SLIST_HOSTCACHEVIEWCOUNT) != me.nItems)
  return;

 if(1){ if (me.selectedServer) { strunzone(me.selectedServer); } me.selectedServer = strzone(gethostcachestring(SLIST_FIELD_CNAME, me.selectedItem)); }else voidfunc();

 me.ipAddressBox.setText(me.ipAddressBox, me.selectedServer);
