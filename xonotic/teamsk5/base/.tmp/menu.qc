    break;
   }
   case "H":
   {


    ((un_emergency_pk3s) = (((un_emergency_pk3s) != "") ? strcat(un_emergency_pk3s, " ", s) : (s)));
    break;
   }
   case "P":
   {
    ((un_promoted) = (((un_promoted) != "") ? strcat(un_promoted, " ", s) : (s)));
    break;
   }
   case "R":
   {
    ((un_recommended) = (((un_recommended) != "") ? strcat(un_recommended, " ", s) : (s)));
    break;
   }
  }
