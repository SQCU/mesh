 if(1){ if (autocvar_developer > 0) dprint(strcat1n("^9[::^7""MENUQC""^9::""^6TRACE""^9] ", (sprintf("^7%s^9(^9%s^7:^9%s^7)", __FUNC__, "./menu/xonotic/slider_resolution.qc", "59")), "\n")); dprint(strcat1n("^7", strcat1n("max factor: ", ftos(maxfactor)), "\n")); }else voidfunc();

