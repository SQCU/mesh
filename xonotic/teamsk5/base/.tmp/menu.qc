   if (it && prev_tooltip != it.tooltip)
   {

    menuTooltipState = 3;
    if(1){ if (prev_tooltip) { strunzone(prev_tooltip); } prev_tooltip = strzone(it.tooltip); }else voidfunc();
   }
   else if (menuTooltipItem && !m_testmousetooltipbox(pos))
