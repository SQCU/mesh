 v = '0 0 0';
 if (a == 0)
 {
  if (b != 0)
  {
   v.x = v.y = -c / b;
   v.z = 1;
  }
  else
  {
   if (c == 0)
   {

    v.z = 1;
   }
  }
 }
 else
 {
  D = b * b - 4 * a * c;
  if (D >= 0)
  {
   D = sqrt(D);
   if (a > 0)
   {
    v.x = ((-b) - D) / (2 * a);
    v.y = ((-b) + D) / (2 * a);
   }
   else
   {
    v.x = (-b + D) / (2 * a);
    v.y = (-b - D) / (2 * a);
   }
   v.z = 1;
