      last = middle;
      catl = cat;
     } else {
      first = middle;
      catf = cat;
     }
    }
    if (catl == j) {
     if(gethostcachenumber(SLIST_FIELD_CATEGORY, last) != j)
      (__self = ((0, null_entity)), builtin_error("Category mismatch III"));
     if(last > 0)
      if(gethostcachenumber(SLIST_FIELD_CATEGORY, last - 1) == j)
       (__self = ((0, null_entity)), builtin_error("Category mismatch IV"));
