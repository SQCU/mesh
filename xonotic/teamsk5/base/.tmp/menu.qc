WepSet _WepSet_FromWeapon(float a)
{
 a -= WEP_FIRST;
 if (Weapons_MAX > 24)
  if (a >= 24)
  {
   a -= 24;
   if (Weapons_MAX > 48)
    if (a >= 24)
    {
     a -= 24;
     return '0 0 1' * (1 << (a));
    }
   return '0 1 0' * (1 << (a));
  }
 return '1 0 0' * (1 << (a));
}

