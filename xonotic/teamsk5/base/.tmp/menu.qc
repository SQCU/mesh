  }
  return 0;
 }

 r_x = width;
 r_y = height;
 r_z = pixelheight;


 c_z = 0;
 c_x = 800;
 c_y = c.x * r.y * r.z / r.x;
 if(c.y < 600)
 {
  c_y = 600;
  c_x = c.y * r.x / (r.y * r.z);
 }

 f = min(r.x / c.x, r.y / c.y);
