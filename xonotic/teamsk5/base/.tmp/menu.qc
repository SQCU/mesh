void XonoticTeamSelectDialog_showNotify(entity me)
{
 (XonoticTeamSelectDialog_vtbl.vtblbase).showNotify(me);
 float teams, nTeams;
 teams = cvar("_teams_available");
 nTeams = 0;
 me.team1.disabled = !(teams & 1); nTeams += ((teams & 1) != 0);
 me.team2.disabled = !(teams & 2); nTeams += ((teams & 2) != 0);
 me.team3.disabled = !(teams & 4); nTeams += ((teams & 4) != 0);
 me.team4.disabled = !(teams & 8); nTeams += ((teams & 8) != 0);
}

