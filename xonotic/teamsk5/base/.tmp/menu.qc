 draw_Picture('0.5 0.5 0' - 0.5 * sz, me.src, sz, rgb, a);
 if(cvar("crosshair_dot"))
 {
  if(cvar("crosshair_dot_color_custom") && (cvar_string("crosshair_dot_color") != "0"))
   rgb = stov(cvar_string("crosshair_dot_color"));

