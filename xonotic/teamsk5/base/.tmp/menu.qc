   if (me.focusedChild) me.selectedChild = me.focusedChild;
   if (!me.selectedChild) me.animationState = 0;
   (Nexposee_vtbl.vtblbase).setFocus(me, (0, null_entity));
   return 1;
  }
  return 0;
