 void Label_recalcPositionWithText(entity me, string t)
 {
  float spaceAvail;
  spaceAvail = 1 - me.keepspaceLeft - me.keepspaceRight;

  if (me.isBold) drawfont = FONT_USER + 3;

  float spaceUsed;
  spaceUsed = draw_TextWidth(t, me.allowColors, me.realFontSize);

