  return;
 }

 if(data == "")
  n = 0;
 else
  n = tokenizebyseparator(data, "\n");

 float i;
 string s;

 string un_version = "";
 string un_tosversion = "";
 string un_download = "";
 string un_url = "";
 string un_bannedservers = "";
 string un_emergency_pk3s = "";
 string un_promoted = "";
 string un_recommended = "";
 string un_compatexpire = "";

 for(i = 0; i < n; ++i)
 {
  s = substring(argv(i), 2, -1);
  if(s == "") { continue; }

  switch(substring(argv(i), 0, 1))
  {
   case "V":
   {
    un_version = s;
    break;
   }
   case "T":
   {
    un_tosversion = s;
    break;
   }
   case "C":
   {
    un_compatexpire = s;
    break;
