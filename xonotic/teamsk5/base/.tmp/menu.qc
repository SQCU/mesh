  theAlpha = SKINALPHA_SERVERLIST_FULL;
 else if(freeslots == 0)
  theAlpha = SKINALPHA_SERVERLIST_FULL;
 else if (!gethostcachenumber(SLIST_FIELD_NUMHUMANS, i))
