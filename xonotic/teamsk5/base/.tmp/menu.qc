   setDependent(e, "hud_panel_powerups_progressbar", 1, 1);
 me.TR(me);
  me.TD(me, 1, 4, e = makeXonoticTextLabel(0, _("Icon alignment:")));
 me.TR(me);
  me.TDempty(me, 0.2);
   me.TD(me, 1, 0.95, e = makeXonoticRadioButton(3, "hud_panel_powerups_iconalign", "0", _("Left")));
