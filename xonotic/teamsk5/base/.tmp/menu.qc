void _MapInfo_Parse_Settemp(string pFilename, string acl, float type, string s, float recurse)
{
 string t;
 float o;

 s = strreplace("\t", "", s);

 t = car(s); s = cdr(s);



 if(substring(t, 0, 1) == "\"")
 {
  if(substring(t, -1, 1) == "\"")
   t = substring(t, 1, -2);
 }


 if(substring(s, 0, 1) == "\"")
 {
  s = substring(s, 1, -1);
 }

 o = _strstrofs(s, "\"", 0);
 if(o >= 0)
  s = substring(s, 0, o);


 o = _strstrofs(s, "//", 0);
 if(o >= 0)
  s = substring(s, 0, o);


 while(substring(s, -1, 1) == " ")
  s = substring(s, 0, -2);

 if(t == "#include")
 {
  if(recurse > 0)
  {
   float fh = fopen(s, FILE_READ);
   if(fh < 0)
   {
    if(false)
     if(1){ if (autocvar_developer > 0) print(strcat1n("^9[::^7""MENUQC""^9::""^3WARNING""^9] ", (sprintf("^7%s^9(^9%s^7:^9%s^7)", __FUNC__, "./common/mapinfo.qc", "706")), "\n")); print(strcat1n("^7", strcat1n("Map ", pFilename, " references not existing config file ", s), "\n")); }else voidfunc();
   }
   else
   {
    while((s = fgets(fh)))
    {
     s = strreplace("\t", "", s);

     if(s == "")
      continue;
     if(substring(s, 0, 1) == "#")
      continue;
     if(substring(s, 0, 2) == "//")
      continue;
     if(substring(s, 0, 1) == "_")
      continue;

     if(substring(s, 0, 4) == "set ")
      s = substring(s, 4, -1);
     if(substring(s, 0, 5) == "seta ")
      s = substring(s, 5, -1);

     _MapInfo_Parse_Settemp(pFilename, acl, type, s, recurse - 1);
    }
    fclose(fh);
   }
  }
  else if(false)
   if(1){ if (autocvar_developer > 0) print(strcat1n("^9[::^7""MENUQC""^9::""^3WARNING""^9] ", (sprintf("^7%s^9(^9%s^7:^9%s^7)", __FUNC__, "./common/mapinfo.qc", "734")), "\n")); print(strcat1n("^7", strcat1n("Map ", pFilename, " uses too many levels of inclusion"), "\n")); }else voidfunc();
 }
 else if(t == ""
  || !cvar_value_issafe(t)
  || !cvar_value_issafe(s)
  || matchacl("-g_mapinfo_* -rcon_* -_* -g_ban* +*", t) <= 0)
 {
  if (false)
   if(1){ if (autocvar_developer > 0) print(strcat1n("^9[::^7""MENUQC""^9::""^3WARNING""^9] ", (sprintf("^7%s^9(^9%s^7:^9%s^7)", __FUNC__, "./common/mapinfo.qc", "742")), "\n")); print(strcat1n("^7", strcat1n("Map ", pFilename, " contains a potentially harmful setting, ignored"), "\n")); }else voidfunc();
 }
 else if(matchacl(acl, t) <= 0)
 {
  if (false)
   if(1){ if (autocvar_developer > 0) print(strcat1n("^9[::^7""MENUQC""^9::""^3WARNING""^9] ", (sprintf("^7%s^9(^9%s^7:^9%s^7)", __FUNC__, "./common/mapinfo.qc", "747")), "\n")); print(strcat1n("^7", strcat1n("Map ", pFilename, " contains a denied setting, ignored"), "\n")); }else voidfunc();
 }
 else
 {
  if(type == 0)
  {
   if(1){ if (autocvar_developer > 0) dprint(strcat1n("^9[::^7""MENUQC""^9::""^6TRACE""^9] ", (sprintf("^7%s^9(^9%s^7:^9%s^7)", __FUNC__, "./common/mapinfo.qc", "753")), "\n")); dprint(strcat1n("^7", strcat1n("Applying temporary setting ", t, " := ", s), "\n")); }else voidfunc();





    cvar_settemp(t, s);
  }
  else
  {
   if(1){ if (autocvar_developer > 0) dprint(strcat1n("^9[::^7""MENUQC""^9::""^6TRACE""^9] ", (sprintf("^7%s^9(^9%s^7:^9%s^7)", __FUNC__, "./common/mapinfo.qc", "763")), "\n")); dprint(strcat1n("^7", strcat1n("Applying temporary client setting ", t, " := ", s), "\n")); }else voidfunc();
   MapInfo_Map_clientstuff = strcat(
     MapInfo_Map_clientstuff, "cl_cmd settemp \"", t, "\" \"", s, "\"\n"
     );
  }
 }
}

float MapInfo_isRedundant(string fn, string t)
{

 fn = strreplace("_", "", fn);
 fn = strreplace("-", "", fn);


 t = strreplace(":", "", t);
 t = strreplace(" ", "", t);
 t = strreplace("_", "", t);
 t = strreplace("-", "", t);
 t = strreplace("'", "", t);
 t = strdecolorize(t);



 if(!_strcasecmp(fn, t))
  return true;

 return false;
}

float _MapInfo_ParseArena(string arena_filename, float fh, string pFilename, Gametype pGametypeToSet, float isdefi, float isgenerator)
{


 float in_brackets = false;
 float dosave = false;
 string stored_Map_description = "";
 string stored_Map_title = "";
 string stored_Map_author = "";
 float stored_supportedGametypes = 0;
 float stored_supportedFeatures = 0;
 float stored_flags = 0;
 string t, s;
 for (;;)
 {
  if (!((s = fgets(fh))))
   break;


  if(s == "")
   continue;
  if(substring(s, 0, 2) == "//")
   continue;
  if(_strstrofs(s, "{", 0) >= 0)
  {
   if(in_brackets)
    return false;
   in_brackets = true;
   continue;
  }
  else if(!in_brackets)
  {

   continue;
  }
  if(_strstrofs(s, "}", 0) >= 0)
  {
   if(!in_brackets)
    return false;
   in_brackets = false;
   if(dosave)
   {
    MapInfo_Map_description = stored_Map_description;
    if(stored_Map_title != "")
     MapInfo_Map_title = stored_Map_title;
    MapInfo_Map_author = stored_Map_author;
    if(isgenerator)
     MapInfo_Map_supportedGametypes = stored_supportedGametypes;
    else
    {
     if(1){ float _i = 0; for (entity _it = Gametypes_first, _next = (0, null_entity); _it; (_it = _next, ++_i)) { const noref float i = _i; const noref entity it = _it; _next = _it.enemy; if (it.m_flags & stored_supportedGametypes) { { { _MapInfo_Map_ApplyGametype ("", pGametypeToSet, it, true); }; } } } }else voidfunc();



    }
    MapInfo_Map_supportedFeatures = stored_supportedFeatures;
    MapInfo_Map_flags = stored_flags;
    return true;
   }
   else
   {

    stored_Map_description = "";
    stored_Map_title = "";
    stored_Map_author = "";
    stored_supportedGametypes = 0;
    stored_supportedFeatures = 0;
    stored_flags = 0;
    continue;
   }
  }

  s = strreplace("\t", " ", s);

  float p = _strstrofs(s, "//", 0);
  if(p >= 0)
   s = substring(s, 0, p);



  while(substring(s, 0, 1) == " ")
   s = substring(s, 1, -1);

  t = car(s); s = cdr(s);
  t = strtolower(t);


  while(substring(t, -1, 1) == " ")
   t = substring(t, 0, -2);


  while(substring(s, -1, 1) == " ")
   s = substring(s, 0, -2);

  while(substring(s, 0, 1) == " ")
   s = substring(s, 1, -1);


  if(substring(s, 0, 1) == "\"")
  {
   if(substring(s, -1, 1) == "\"")
    s = substring(s, 1, -2);
  }
  if(t == "longname")
   stored_Map_title = s;
  else if(t == "author")
   stored_Map_author = s;
  else if(t == "type")
  {

   stored_supportedFeatures |= MAPINFO_FEATURE_WEAPONS;


   string types = s;
   types = strreplace("team", "tdm ft", types);
   types = strreplace("ffa", "dm lms ka", types);
   if(_strstrofs(types, "tournament", 0) < 0 && _strstrofs(types, "tdm", 0) >= 0)
    types = cons(types, "ca kh");
   if(1){ string _words = types; float _i = 0; for (string _it; (_it = car(_words)); (_words = cdr(_words), ++_i)) { const noref float i = _i; const noref string it = _it; if (true) { { { Gametype f = MapInfo_Type_FromString(it, false, true); if(f) stored_supportedGametypes |= f.m_flags; }; } } } }else voidfunc();





  }
  else if(t == "style" && isdefi)
  {


   stored_supportedGametypes |= MAPINFO_TYPE_CTS.m_flags;
  }
  else if(t == "map")
  {
   if(strtolower(s) == strtolower(pFilename))
    dosave = true;
  }
  else if(t == "quote")
   stored_Map_description = s;

 }


 return false;
}

string _MapInfo_CheckArenaFile(string pFilename, string pMapname)
{


 float fh = fopen(pFilename, FILE_READ);
 if(fh < 0)
  return "";
 for(string s; (s = fgets(fh)); )
 {
  s = strreplace("\t", "", s);
  while(substring(s, 0, 1) == " ")
   s = substring(s, 1, -1);
  if(substring(s, 0, 2) == "//")
   continue;
  if(s == "")
   continue;
  float offset = _strstrofs(s, "map", 0);
  if(offset >= 0)
  {
   if(_strstrofs(strtolower(s), strcat("\"", strtolower(pMapname), "\""), offset) >= 0)
   {
    fclose(fh);
    return pFilename;
   }
  }
 }
 fclose(fh);
 return "";
}

string _MapInfo_FindArenaFile(string pFilename, string extension)
{
 string fallback = strcat("scripts/", pFilename, extension);
 if(!checkextension("DP_QC_FS_SEARCH_PACKFILE"))
  return _MapInfo_CheckArenaFile(fallback, pFilename);
 string base_pack = whichpack(strcat("maps/", pFilename, ".bsp"));
 if(base_pack == "")
  return _MapInfo_CheckArenaFile(fallback, pFilename);

 float glob = search_packfile_begin(strcat("scripts/*", extension), true, true, base_pack);
 if(glob < 0)
  return _MapInfo_CheckArenaFile(fallback, pFilename);
 float n = search_getsize(glob);
 for(float j = 0; j < n; ++j)
 {
  string file = search_getfilename(glob, j);
  if(_MapInfo_CheckArenaFile(file, pFilename) != "")
  {
   search_end(glob);
   return file;
  }
 }

 search_end(glob);
 return "";
}


float MapInfo_Get_ByName_NoFallbacks(string pFilename, float pAllowGenerate, Gametype pGametypeToSet)
{
 string fn;
 string s, t;
 float fh;
 float f, i;
 float r, n;
 string acl;

 acl = cvar_string("g_mapinfo_settemp_acl");

 if(_strstrofs(pFilename, "/", 0) >= 0)
 {
  if(1){ if (autocvar_developer > 0) print(strcat1n("^9[::^7""MENUQC""^9::""^3WARNING""^9] ", (sprintf("^7%s^9(^9%s^7:^9%s^7)", __FUNC__, "./common/mapinfo.qc", "1009")), "\n")); print(strcat1n("^7", strcat1n("Invalid character in map name, ignored"), "\n")); }else voidfunc();
  return 0;
 }

 if(pGametypeToSet == (0, null_entity))
  if(MapInfo_Cache_Retrieve(pFilename))
   return 1;

 r = 1;

 MapInfo_Map_bspname = pFilename;


 fn = strcat("maps/", pFilename, ".mapinfo");
 fh = fopen(fn, FILE_READ);
 if(fh < 0)
 {
  if(autocvar_g_mapinfo_q3compat)
  {
   float isdefi = false;
   if(autocvar_g_mapinfo_q3compat == 1)
   {
    fn = _MapInfo_FindArenaFile(pFilename, ".arena");
    if(fn != "")
     fh = fopen(fn, FILE_READ);
   }
   if(fh < 0 || autocvar_g_mapinfo_q3compat == 2)
   {
    isdefi = true;
    fn = _MapInfo_FindArenaFile(pFilename, ".defi");
    if(fn != "")
     fh = fopen(fn, FILE_READ);
   }
   if(fh >= 0)
   {
    _MapInfo_Map_Reset();
    if(_MapInfo_ParseArena(fn, fh, pFilename, pGametypeToSet, isdefi, false))
     goto mapinfo_handled;
   }
  }

  fn = strcat("maps/autogenerated/", pFilename, ".mapinfo");
  fh = fopen(fn, FILE_READ);
  if(fh < 0)
  {
   if(!pAllowGenerate)
    return 0;
   _MapInfo_Map_Reset();
   r = _MapInfo_Generate(pFilename);
   if(!r)
    return 0;
   fh = fopen(fn, FILE_WRITE);
   fputs(fh, strcat("title ", MapInfo_Map_title, "\n"));
   fputs(fh, strcat("description ", MapInfo_Map_description, "\n"));
   fputs(fh, strcat("author ", MapInfo_Map_author, "\n"));
