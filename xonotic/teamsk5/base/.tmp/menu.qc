       if(1){ if (autocvar_developer > 1) dprint(strcat1n("^9[::^7""MENUQC""^9::""^5INFO""^9] ", (sprintf("^7%s^9(^9%s^7:^9%s^7)", __FUNC__, "./common/command/generic.qc", "249")), "\n")); string __s = strcat1n("maplist: ERROR: ", argv(2), " does not exist!"); print("^7", __s); if (_str2chr(__s, strlen(__s) - 1) != '\n') { print("\n"); } }else voidfunc();
       break;
      }

      if(cvar_string("g_maplist") == "")
       cvar_set("g_maplist", argv(2));
      else
       cvar_set("g_maplist", strcat(argv(2), " ", cvar_string("g_maplist")));

      return;
     }
     break;
    }

    case "cleanup":
    {
     MapInfo_Enumerate();
     MapInfo_FilterGametype(MapInfo_CurrentGametype(), MapInfo_CurrentFeatures(), MapInfo_RequiredFlags(), MapInfo_ForbiddenFlags(), 0);
     string filtered = "";
     if(1){ string _words = cvar_string("g_maplist"); float _i = 0; for (string _it; (_it = car(_words)); (_words = cdr(_words), ++_i)) { const noref float i = _i; const noref string it = _it; if (MapInfo_CheckMap(it)) { { filtered = cons(filtered, it); } } } }else voidfunc();
     cvar_set("g_maplist", filtered);
     return;
    }

    case "remove":
    {
     if(argc == 3)
     {

      string del_map_name = argv(2);
      argc = tokenizebyseparator(cvar_string("g_maplist"), " ");

      tmp_string = "";
      for(i = 0; i < argc; ++i)
       if(argv(i) != del_map_name)
        tmp_string = strcat(tmp_string, " ", argv(i));

      tmp_string = substring(tmp_string, 1, strlen(tmp_string) - 1);
      cvar_set("g_maplist", tmp_string);

      return;
     }
     break;
    }

    case "shuffle":
    {
     cvar_set("g_maplist", shufflewords(cvar_string("g_maplist")));
     return;
    }

    default: break;
   }
  }

  default:
   if(1){ if (autocvar_developer > 1) dprint(strcat1n("^9[::^7""MENUQC""^9::""^5INFO""^9] ", (sprintf("^7%s^9(^9%s^7:^9%s^7)", __FUNC__, "./common/command/generic.qc", "305")), "\n")); string __s = sprintf("Incorrect parameters for ^2%s^7", argv(0)); print("^7", __s); if (_str2chr(__s, strlen(__s) - 1) != '\n') { print("\n"); } }else voidfunc();
