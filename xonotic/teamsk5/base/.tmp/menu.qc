 me.favoriteButton.disabled = (me.ipAddressBox.text == "");

 float found = false;
 if(me.lockedSelectedItem)
 {
  if(me.nItems > 0)
  {
   if(gethostcachestring(SLIST_FIELD_CNAME, me.selectedItem) != me.selectedServer)
   {
    if(1){ if (me.selectedServer) { strunzone(me.selectedServer); } me.selectedServer = strzone(gethostcachestring(SLIST_FIELD_CNAME, me.selectedItem)); }else voidfunc();
   }
   found = true;
  }
 }
 else if(me.selectedServer)
