void ScreenshotList_Filter_Change(entity box, entity me)
{
 if(1){ if (me.filterString) { strunzone(me.filterString); } me.filterString = nil; }else voidfunc();

 if(box.text != "")
 {
  if (_strstrofs(box.text, "*", 0) >= 0 || _strstrofs(box.text, "?", 0) >= 0)
   me.filterString = strzone(box.text);
  else
   me.filterString = strzone(strcat("*", box.text, "*"));
