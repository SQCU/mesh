#define autocvar_g_payload_point_limit cvar("g_payload_point_limit")
int autocvar_g_payload_point_leadlimit;

IntrusiveList g_payload_nodes;
void payload_Initialize();

REGISTER_MUTATOR(plc, false)
{
	MUTATOR_STATIC();
	MUTATOR_ONADD
	{
		GameRules_teams(true);
		GameRules_limit_score(autocvar_g_payload_point_limit);
		GameRules_limit_lead(autocvar_g_payload_point_leadlimit);

		payload_Initialize();
	}
	return 0;
}

