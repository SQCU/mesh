.int plc_link_team_b;

#ifdef CSQC
void HUD_Mod_Payload(vector pos, vector mySize);
void HUD_Mod_Payload_Export(int fh);

bool   plc_r_present;
float  plc_r_frac;
int    plc_r_ctrl;
