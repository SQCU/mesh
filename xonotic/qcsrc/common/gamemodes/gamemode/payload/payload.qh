#pragma once

#include <common/mapinfo.qh>
#include <common/teams.qh>

const int PLC_MAX_CARTS = 4;
const int PLC_RIBBON_SEG = 4;

const int PLC_PUSH_BITS = 6;
const int PLC_PUSH_MASK = 63;
const float PLC_PUSH_SCALE = 4;

const int PLC_CS_BITS = 5;
const int PLC_CS_MASK = 31;
const int PLC_CS_REGRESS = 8;
const int PLC_CS_STALL = 16;

// cart simulation tick; shared so the client can lay cart ink on the same cadence
const float PLC_TICK = 0.1;

// where the cart's waypointsprite sits relative to the cart, so the client can
// recover the cart from the sprite's networked origin.  One definition: sv spawns
// the sprite at this offset and cl subtracts it.
const vector PLC_SPRITE_OFS = '0 0 64';

// the colour of a cart nobody controls
const vector PLC_GREY = '0.55 0.55 0.55';

float payload_unpack_push(int packed, int idx);
int payload_unpack_cart_state(int packed, int c);

#ifdef CSQC
void HUD_Mod_Payload(vector pos, vector mySize);
void HUD_Mod_Payload_Export(int fh);

// ---------------------------------------------------------------------------
// The one definition of "what is cart c doing".
//
// Four things draw a cart - the modicons row, the procedural world body, the
// supermassive sky body, and the ink the cart lays on the level - and all four
// read it through payload_cart_read() and nowhere else.  A second unpacking of
// PAYLOAD_CARTS_STATE, a second team-colour lookup or a second control-state
// palette anywhere in the client is a defect on sight (design/CAST.md).
//
// Every field below is decoded from state the server already networks:
//   PAYLOAD_CARTS_STATE   control team + regress/stall, 5 bits per cart
//   PAYLOAD_GOALS_PACKED  presence + coarse arclength, 6 bits per cart
//   PAYLOAD_PROGRESS      cart 0's arclength at full precision
//   PAYLOAD_PUSH_PACKED*  per-team occupancy weight of each cart's cylinder
//   the cart's own waypointsprite  its exact world origin (it is spawned with
//                                  ref = the cart, so the sprite's networked
//                                  origin IS the cart's origin, tracked every
//                                  server frame) and, in the sprite's spare
//                                  wp_extra byte, which cart it belongs to.
// ---------------------------------------------------------------------------

bool   plc_r_present;      ///< this cart exists in the match
float  plc_r_frac;         ///< 0..1 along its path
int    plc_r_ctrl;         ///< controlling team index, 0 = uncontrolled
bool   plc_r_regress;      ///< being driven back toward its path origin
bool   plc_r_stall;        ///< occupied but not moving
int    plc_r_lead;         ///< strongest team in the cylinder, 0 = empty
int    plc_r_second;       ///< second strongest, 0 = uncontested
int    plc_r_home;         ///< the team driving it home (regression only)
float  plc_r_contest;      ///< 0 uncontested .. 1 dead heat
vector plc_r_color;        ///< primary body colour for this control state
vector plc_r_color2;       ///< the contesting colour; == plc_r_color if none
vector plc_r_inkcolor;     ///< what this cart lays on the world this tick
float  plc_r_glow;         ///< emissive strength, 0..1
bool   plc_r_haveorigin;   ///< the cart's sprite has arrived on this client
vector plc_r_origin;       ///< its exact world origin

int payload_cart_push_packed(int c);
vector payload_link_color(int nibble);
void payload_cart_read(int c);
#endif
CLASS(Payload, Gametype)
    INIT(Payload)
    {
        this.gametype_init(this, _("Payload"),"plc","g_payload",GAMETYPE_FLAG_TEAMPLAY | GAMETYPE_FLAG_USEPOINTS,"","timelimit=20 pointlimit=10 teams=3 leadlimit=0",_("Push the cart to your team's goal"));
    }
    METHOD(Payload, m_parse_mapinfo, bool(string k, string v))
    {
        if (!k) {
            cvar_set("g_payload_default_teams", cvar_defstring("g_payload_default_teams"));
            return true;
        }
        switch (k) {
            case "teams":
                cvar_set("g_payload_default_teams", v);
                return true;
        }
        return false;
    }
    METHOD(Payload, m_generate_mapinfo, void(Gametype this, string v))
    {
        MapInfo_Map_supportedGametypes |= this.m_flags;
    }
    METHOD(Payload, m_isForcedSupported, bool(Gametype this))
    {
        return true;
    }
    METHOD(Payload, m_configuremenu, void(Gametype this, entity menu, void(entity me, string pLabel, float pMin, float pMax, float pStep, string pCvar, string tCvar, string pTooltip) returns))
    {
        TC(Gametype, this);
        returns(menu, _("Capture limit:"), 1, 20, 1, "g_payload_point_limit", "g_payload_teams_override", _("The amount of captures needed before the match will end"));
    }
#ifdef CSQC
    ATTRIB(Payload, m_modicons, void(vector pos, vector mySize), HUD_Mod_Payload);
    ATTRIB(Payload, m_modicons_export, void(int fh), HUD_Mod_Payload_Export);
#endif
    ATTRIB(Payload, m_legacydefaults, string, "10 20 0");
ENDCLASS(Payload)
REGISTER_GAMETYPE(PAYLOAD, NEW(Payload));

// THE CART SIZE CONTRACT. One definition, shared by every path that makes a cart
// and by every tool that validates clearance for one.
//
// There were three. sv_payload.qc's synthesised cart used setsize('-32 -32 -24',
// '32 32 40'); tools/negspace.py laid track for CART_MAX z=56; and mkentfile
// emitted func_plc_cart with a brush model of whatever size the map had. So the
// offline validator certified clearance for a cart the engine never spawns, and
// the entity the map authored was a third shape again -- which is unreachable
// anyway, because g_payload_lane_synthesis defaults to 1 and spawnfunc deletes it.
#define PLC_CART_MIN '-32 -32 -24'
#define PLC_CART_MAX '32 32 56'
