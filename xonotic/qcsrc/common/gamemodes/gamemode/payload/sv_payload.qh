REGISTER_MUTATOR(plc, false)
{
	MUTATOR_STATIC();
	MUTATOR_ONADD
	{
		GameRules_teams(true);
		GameRules_limit_score(0);
		GameRules_limit_lead(0);
		GameRules_limit_time(0);

		payload_Initialize();
	}
	return 0;
}

