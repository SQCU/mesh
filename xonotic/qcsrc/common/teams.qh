#pragma once

const int NUM_TEAMS = 256;

const int NUM_TEAM_1 = 1;
const int NUM_TEAM_2 = 2;
const int NUM_TEAM_3 = 3;
const int NUM_TEAM_4 = 4;
const int NUM_TEAM_5 = 5;
const int NUM_TEAM_6 = 6;
const int NUM_TEAM_7 = 7;
const int NUM_TEAM_8 = 8;
const int NUM_SPECTATOR = 257;

const string COL_TEAM_1 = "^1";
const string COL_TEAM_2 = "^4";
const string COL_TEAM_3 = "^3";
const string COL_TEAM_4 = "^6";
const string COL_TEAM_5 = "^2";
const string COL_TEAM_6 = "^xF80";
const string COL_TEAM_7 = "^5";
const string COL_TEAM_8 = "^7";

#define NAME_TEAM_1 CTX(_("TEAM^Red"))
#define NAME_TEAM_2 CTX(_("TEAM^Blue"))
#define NAME_TEAM_3 CTX(_("TEAM^Yellow"))
#define NAME_TEAM_4 CTX(_("TEAM^Pink"))
#define NAME_TEAM_5 CTX(_("TEAM^Green"))
#define NAME_TEAM_6 CTX(_("TEAM^Orange"))
#define NAME_TEAM_7 CTX(_("TEAM^Cyan"))
#define NAME_TEAM_8 CTX(_("TEAM^White"))
#define NAME_TEAM _("Team")
#define NAME_NEUTRAL _("Neutral")

#define KEY_TEAM_1 CTX(_("KEY^Red"))
#define KEY_TEAM_2 CTX(_("KEY^Blue"))
#define KEY_TEAM_3 CTX(_("KEY^Yellow"))
#define KEY_TEAM_4 CTX(_("KEY^Pink"))
#define KEY_TEAM_5 CTX(_("KEY^Green"))
#define KEY_TEAM_6 CTX(_("KEY^Orange"))
#define KEY_TEAM_7 CTX(_("KEY^Cyan"))
#define KEY_TEAM_8 CTX(_("KEY^White"))
#define FLAG_TEAM_1 CTX(_("FLAG^Red"))
#define FLAG_TEAM_2 CTX(_("FLAG^Blue"))
#define FLAG_TEAM_3 CTX(_("FLAG^Yellow"))
#define FLAG_TEAM_4 CTX(_("FLAG^Pink"))
#define FLAG_TEAM_5 CTX(_("FLAG^Green"))
#define FLAG_TEAM_6 CTX(_("FLAG^Orange"))
#define FLAG_TEAM_7 CTX(_("FLAG^Cyan"))
#define FLAG_TEAM_8 CTX(_("FLAG^White"))
#define GENERATOR_TEAM_1 CTX(_("GENERATOR^Red"))
#define GENERATOR_TEAM_2 CTX(_("GENERATOR^Blue"))
#define GENERATOR_TEAM_3 CTX(_("GENERATOR^Yellow"))
#define GENERATOR_TEAM_4 CTX(_("GENERATOR^Pink"))
#define GENERATOR_TEAM_5 CTX(_("GENERATOR^Green"))
#define GENERATOR_TEAM_6 CTX(_("GENERATOR^Orange"))
#define GENERATOR_TEAM_7 CTX(_("GENERATOR^Cyan"))
#define GENERATOR_TEAM_8 CTX(_("GENERATOR^White"))

const string STATIC_NAME_TEAM_1 = "Red";
const string STATIC_NAME_TEAM_2 = "Blue";
const string STATIC_NAME_TEAM_3 = "Yellow";
const string STATIC_NAME_TEAM_4 = "Pink";
const string STATIC_NAME_TEAM_5 = "Green";
const string STATIC_NAME_TEAM_6 = "Orange";
const string STATIC_NAME_TEAM_7 = "Cyan";
const string STATIC_NAME_TEAM_8 = "White";

#ifdef CSQC
bool teamplay;
int myteam;
#endif

string Team_ColorCode(int teamid)
{
	switch(teamid)
	{
		case NUM_TEAM_1: return COL_TEAM_1;
		case NUM_TEAM_2: return COL_TEAM_2;
		case NUM_TEAM_3: return COL_TEAM_3;
		case NUM_TEAM_4: return COL_TEAM_4;
		case NUM_TEAM_5: return COL_TEAM_5;
		case NUM_TEAM_6: return COL_TEAM_6;
		case NUM_TEAM_7: return COL_TEAM_7;
		case NUM_TEAM_8: return COL_TEAM_8;
	}

	if(teamid >= 1 && teamid <= NUM_TEAMS)
		return Team_ColorCode((teamid - 1) % 8 + 1);
	return "^7";
}

vector Team_ColorRGB(int teamid)
{
	switch(teamid)
	{
		case NUM_TEAM_1: return '1 0.0625 0.0625';
		case NUM_TEAM_2: return '0.0625 0.0625 1';
		case NUM_TEAM_3: return '1 1 0.0625';
		case NUM_TEAM_4: return '1 0.0625 1';
		case NUM_TEAM_5: return '0.0625 1 0.0625';
		case NUM_TEAM_6: return '1 0.5 0.0625';
		case NUM_TEAM_7: return '0.0625 1 1';
		case NUM_TEAM_8: return '0.75 0.75 0.75';
	}

	if(teamid >= 1 && teamid <= NUM_TEAMS)
	{
		float a = 6.28318530718 * (teamid - 1) / NUM_TEAMS;
		return '0.55 0.55 0.55' + 0.45 * vec3(cos(a), cos(a - 2.09439510239), cos(a + 2.09439510239));
	}
	return '0 0 0';
}

string Team_ColorName(int teamid)
{
	switch(teamid)
	{
		case NUM_TEAM_1: return NAME_TEAM_1;
		case NUM_TEAM_2: return NAME_TEAM_2;
		case NUM_TEAM_3: return NAME_TEAM_3;
		case NUM_TEAM_4: return NAME_TEAM_4;
		case NUM_TEAM_5: return NAME_TEAM_5;
		case NUM_TEAM_6: return NAME_TEAM_6;
		case NUM_TEAM_7: return NAME_TEAM_7;
		case NUM_TEAM_8: return NAME_TEAM_8;
	}

	return teamid >= 1 && teamid <= NUM_TEAMS ? strcat(NAME_TEAM, " ", ftos(teamid)) : NAME_NEUTRAL;
}

string Static_Team_ColorName(int teamid)
{
	switch(teamid)
	{
		case NUM_TEAM_1: return STATIC_NAME_TEAM_1;
		case NUM_TEAM_2: return STATIC_NAME_TEAM_2;
		case NUM_TEAM_3: return STATIC_NAME_TEAM_3;
		case NUM_TEAM_4: return STATIC_NAME_TEAM_4;
		case NUM_TEAM_5: return STATIC_NAME_TEAM_5;
		case NUM_TEAM_6: return STATIC_NAME_TEAM_6;
		case NUM_TEAM_7: return STATIC_NAME_TEAM_7;
		case NUM_TEAM_8: return STATIC_NAME_TEAM_8;
	}

	return teamid >= 1 && teamid <= NUM_TEAMS ? strcat("Team", ftos(teamid)) : NAME_NEUTRAL;
}

float Team_ColorToTeam(string team_color)
{
	switch(strtolower(team_color))
	{
		case "red": return NUM_TEAM_1;
		case "blue": return NUM_TEAM_2;
		case "yellow": return NUM_TEAM_3;
		case "pink": return NUM_TEAM_4;
		case "green": return NUM_TEAM_5;
		case "orange": return NUM_TEAM_6;
		case "cyan": return NUM_TEAM_7;
		case "white": return NUM_TEAM_8;
		case "auto": return 0;
	}

	int parsed = stof(team_color);
	if(substring(strtolower(team_color), 0, 4) == "team")
		parsed = stof(substring(team_color, 4, -1));
	return parsed >= 1 && parsed <= NUM_TEAMS ? parsed : -1;
}

bool Team_IsValidTeam(int team_num)
{
	return team_num >= 1 && team_num <= NUM_TEAMS;
}

bool Team_IsValidIndex(int index)
{
	return index >= 1 && index <= NUM_TEAMS;
}

int Team_IndexToTeam(int index)
{
	return Team_IsValidIndex(index) ? index : -1;
}

int Team_TeamToIndex(int team_num)
{
	return Team_IsValidTeam(team_num) ? team_num : -1;
}

#define TeamByColor(teamid) (Team_TeamToIndex(teamid) - 1)
#define ColorByTeam(number) Team_IndexToTeam(number + 1)

#define Team_ColorName_Lower(teamid) strtolower(Team_ColorName(teamid))
#define Team_ColorName_Upper(teamid) strtoupper(Team_ColorName(teamid))

#define Static_Team_ColorName_Lower(teamid) strtolower(Static_Team_ColorName(teamid))
#define Static_Team_ColorName_Upper(teamid) strtoupper(Static_Team_ColorName(teamid))

#define Team_FullName(teamid) strcat(Team_ColorName(teamid), " ", NAME_TEAM, "^7")
#define Team_ColoredFullName(teamid) strcat(Team_ColorCode(teamid), Team_ColorName(teamid), " ", NAME_TEAM, "^7")

#define Team_IndexToFullName(index) Team_FullName(Team_IndexToTeam(index))
#define Team_IndexToColoredFullName(index) Team_ColoredFullName(Team_IndexToTeam(index))

#define TCR(input,type,team) strreplace("^TC", COL_TEAM_##team, strreplace("^TT", strtoupper(type##_TEAM_##team), input))

#define SAME_TEAM(a,b) (teamplay ? (a.team == b.team) : (a == b))
#define DIFF_TEAM(a,b) (teamplay ? (a.team != b.team) : (a != b))
