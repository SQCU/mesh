

ERASEABLE
string markdown(string s)
{
	string buf = "";
	int lines = 0;
	int spaces = 0;
	FOREACH_CHAR(s, true, {
		switch (it) {
			default:
				for (; spaces > 0; --spaces) {
					buf = strcat(buf, " ");
				}
				buf = strcat(buf, chr2str(it));
				break;
			case ' ':
				spaces += 1;
				break;
			case '\n':
				lines += 1;
				if (lines > 1) {
					lines = 0;
					spaces = 0;
					buf = strcat(buf, "\n\n");
					break;
				}
				if (spaces < 2) {
					spaces = 1;
				} else {
					spaces = 0;
					buf = strcat(buf, "\n");
				}
				break;
		}
	});
	return buf;
}
