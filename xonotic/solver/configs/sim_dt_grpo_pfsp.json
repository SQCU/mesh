{
  "extends": "training_default.json",
  "losses_file": "losses.json",
  "sim_dt": {
    "dt": 0.4,
    "mode": "analytic",
    "dtype": "bfloat16",
    "base_envs": 32,
    "group_size": 8,
    "warmup_steps_min": 15,
    "warmup_steps_max": 50,
    "rollout_horizon": 40,
    "iterations": 24,
    "mid_snapshot_iter": 12,
    "ppo_epochs": 2,
    "target_microbatch_rows": 4096,
    "target_opt_steps_per_epoch": 12,
    "grpo_weight": 0.6,
    "gae_weight": 0.4,
    "terminal_win_bonus": 0.0,
    "point_limit_base": 160.0,
    "common_random_numbers": true,
    "eval_interval": 6,
    "eval_matches_per_pair": 64,
    "eval_horizon": 180,
    "pfsp_update_ema": 0.8,
    "darkplaces_transfer_eval": true,
    "darkplaces_eval_episodes": 2,
    "darkplaces_point_limit": 160.0
  },
  "losses": {
    "reward": {
      "winner_barrier_margin": 0.25,
      "winner_barrier_weight": 0.5,
      "potential_shaping_weight": 0.25,
      "potential_shaping_gamma": 0.95,
      "loser_potential_self_weight": 0.5,
      "cart_partial_cp_weight": 0.5,
      "lane_progress_weight": 0.0,
      "push_weight": 0.0,
      "contest_weight": 0.0,
      "pickup_weight": 0.0
    }
  },
  "world": {
    "mode": "parametric_stream",
    "teams_min": 4,
    "teams_max": 12,
    "teams_dist": "uniform",
    "carts_per_team_min": 2.0,
    "carts_per_team_max": 4.5,
    "carts_dist": "uniform",
    "players_per_team_min": 6,
    "players_per_team_max": 12,
    "players_per_team_low": 6,
    "players_per_team_high": 10,
    "players_min": 24,
    "players_max": 96,
    "tiles_min": 3,
    "tiles_max": 8
  },
  "optimizer": {
    "lr": 0.002,
    "scalar_lr": 0.004,
    "grad_clip": 1.0
  }
}
