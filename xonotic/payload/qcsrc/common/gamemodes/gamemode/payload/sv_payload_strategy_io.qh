// Event kinds on the perception ring. 0..3 are perception-gated observations.
// 4 is the map's own V-cell adjacency: which cells are joined by a stock
// waypoint link, i.e. which cells are contiguous and NAVIGABLE. It is map
// geometry, not enemy information, so it is not perception-gated (E1/E8 gate
// enemy positions and item availability, which is what an opponent could hide);
// bots already traverse these links through stock navigation. Without it the
// belief pipeline's V-cell segmentation has to guess contiguity from a nearest-
// neighbour stand-in instead of fusing genuinely navigable cells.
const float PLC_EVT_KIND_ITEM_GONE  = 0;
const float PLC_EVT_KIND_ITEM_HERE  = 1;
const float PLC_EVT_KIND_ENEMY_HERE = 2;
const float PLC_EVT_KIND_RIVAL_HERE = 3;
const float PLC_EVT_KIND_CELL_LINK  = 4;

// Cell-link rows are streamed a few per strategy step so they never crowd the
// perception events out of the 256-row ring; the table is static, so the sweep
// runs once.
const float PLC_STR_LINKS_PER_STEP = 2;

const float PLC_SC_TARGET = 0;
