#pragma once
// mesh IPC builtins — canonical copy of bridge/qc/mesh_ipc.qh, vendored into the
// payload gamemode so the strategy module compiles as part of SVQC. Numbers match
// bridge/engine/mesh_ipc.c (#644..#653). Guarded so a double-include is inert.
float(float node, float width, float maxrows) mesh_open = #644;
void(float h, float col, .float fld, float firstedict, float numedicts) mesh_gather = #648;
void(float h, float col, .float fld, float firstedict, float numedicts) mesh_scatter = #649;
float(float h, float tick, float nrows) mesh_publish = #650;
float(float h) mesh_poll = #651;
float(float h, float sel) mesh_stat = #653;

#define MESH_STAT_PUBLISHED 0
#define MESH_STAT_COMPLETE 1
#define MESH_STAT_INFLIGHT 2
#define MESH_STAT_WIDTH 3
#define MESH_STAT_MAXROWS 4
#define MESH_STAT_ATTACHED 5
#define MESH_STAT_DROPPED 6
#define MESH_STAT_REQROWS 7
#define MESH_STAT_TXSLOTS 8
#define MESH_STAT_SHORTWRITES 9
#define MESH_STAT_ROWS 10
#define MESH_STAT_RESPCHUNKS 11
#define MESH_STAT_TICK 12
#define MESH_STAT_ARENA 13
#define MESH_STAT_USABLE 14
#define MESH_STAT_PEER 15
