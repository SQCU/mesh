#!/usr/bin/env python3
"""mesh-lint: forms in the bridge, the collective and their clients that design/rubrics.md ranks below another form,
each printed as the rubric's ranked pair with the operator's words that make it the operator's judgement.  A form a
pattern finds is reported on every run; --semantic gives a language model the rubric's text and one function at a time.
A file is ranked by its kind's dimensions only (design/rubrics.md, "Three kinds of source": KINDS below).

  bin/mesh-lint [--semantic] [--strict] [paths...]
    path:line: <dimension> (design/rubrics.md:<line>): <found form> ≺ <higher form>
        <the operator's words, dated>
"""
import argparse
import ast
import concurrent.futures
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
RDMA = ROOT / 'rdma'
RUBRIC = ROOT / 'design' / 'rubrics.md'
RUBRIC_TEXT = RUBRIC.read_text()
RUBRIC_LINES = RUBRIC_TEXT.split('\n')
RUBRIC_FLAT = re.sub(r'\s+', ' ', RUBRIC_TEXT)

# design/rubrics.md "Three kinds of source", its table: the first pattern a file's path matches names its kind
KINDS = (('C', r'rdma/(nccl[\w.-]*|mesh-collective\.c|mesh-plan\.h|mesh\.metal|mesh_mpi\.py|'
               r'torch-mesh/torch_mesh/(backend\.py|fused\.py|__init__\.py|_stream\.mm))'),
         ('D', r'examples/.*|rdma/torch-mesh/.*|rdma/mesh-coreml\.m'),
         ('M', r'rdma/.*'))
KIND_NAMES = {'M': 'mesh', 'C': 'collective', 'D': 'data'}

# functions a step's critical path runs through, per file
DATA_PATH = {
    'rdma/mesh-link.c': r'lane_send|lane_post|link_receive|link_send|stream_turn_one|stream_send|stream_post|'
                        r'stream_receive_turn|walk_\w+|unit_told|holding_kept|port_pass|page_span|row_at|cursor_\w+|page_done|plan_find|'
                        r'entry_complete',
    'rdma/nccl-mesh.c': r'tables_start|gpu_wait|gpu_finished|run|consume|publish|launch_metal|launch|retire|'
                        r'issue_group|walk|schedule|place_group|gate_of|fusable',
    'rdma/torch-mesh/torch_mesh/_stream.mm': r'encode|fused_exchange|fused_published|published|signalled',
}
PER_UNIT = r'lane_send|lane_post|unit_told|link_receive|link_send|stream_send|stream_post|walk_\w+|cursor_step|page_done'
CLOCK = r'\b(mach_absolute_time|clock_gettime_nsec_np|clock_gettime|CFAbsoluteTimeGetCurrent)\s*\('
TIMED_WAIT = r'\b(nanosleep|usleep|sleep|os_sync_wait_on_address_with_timeout|dispatch_semaphore_wait|' \
             r'pthread_cond_timedwait)\s*\('
# the library's landing waits (rdma/mesh.metal, nccl-mesh-kernels.h STEPS)
LANDING_WAITS = {'mesh_wait_bounded', 'mesh_wait', 'mesh_remote_wait', 'mesh_step_wait', 'mesh_step_counts',
                 'mesh_step_await', 'mesh_step_sent'}
# shared words and the one writer of each, against the cache line (hw.cachelinesize)
WRITERS = {
    'mesh_stream': {'owner': 'client', 'sends': 'client', 'lands': 'client', 'ready': 'gpu', 'sent': 'send',
                    'taken[0]': 'send', 'landed': 'receive', 'taken[1]': 'receive', 'posts[0]': 'send',
                    'posts[1]': 'receive'},
    'lane_state': {'sent': 'send', 'done': 'send', 'posted': 'receive', 'got': 'receive'},
}

C4_PAIR = ('the operator\'s pair: lower, "innocent sounding barriers" (2026-10-17); upper, "earlier waitless '
           'implementatinos which did not need to be made waitful" (2026-10-16)')
OVERHEAD = ('the operator, 2026-10-20: "if there is 10ns of reducible overhead anywhere in our code we reduce it to '
            '0ns."')
TIMING = ('the operator, 2026-10-22: "we don\'t introduce race conditions or use timing anywhere"; "using timing is '
          'always slower than not using timing"')
ONE_FORM_D = ('the operator\'s pair: lower, "23 different rmsnorm implementations in random places" (2026-10-14); '
              'upper, "a header import and oneliner for two sorts of modules" (2026-10-19)')
ONE_FORM_C = ('the operator\'s pair: lower, "a mandate to write a template 20 to 40 times"; upper, "a header or '
              'abstract function / higher order function which takes other functions (consumers in a general sense) '
              'as operands" (2026-10-08)')

# each form found: per kind, (dimension, the rubric text it is ranked at, the found form, the higher form, the words)
EVIDENCE = {
    'qp': {'M': ('M3', 'a queue pair moved to RESET or ERR, or destroyed, inside the running process ≺',
                 'a queue pair moved to RESET or ERR, or destroyed, inside the running process',
                 'queue pairs made and connected once and released only by the process\'s exit',
                 'the operator, 2026-10-20: "why do you think you\'re \'allowed\' to do \'teardowns\' in the '
                 'operation of any code we are discussing?"')},
    'residency': {'C': ('C4', 'innocent sounding barriers',
                        '{}: a dispatch declaring every allocation of a residency set (useResource over '
                        'allAllocations), its pass ordered against every pass that names any of them',
                        'a dispatch declaring the buffers its records name', C4_PAIR)},
    'claim': {'M': ('M4', 'them as overwritable at the moment it is known they have no further consumers',
                    '{}: a claim by compare-and-swap on a word that takes its value again (`{}` stored back): a stale '
                    'claimer\'s swap succeeds on a later holder\'s state and releases what that holder still uses '
                    '(rubric review 2026-10-22, finding 4: mesh_retired_release)',
                    'rows released at the moment it is known they have no further consumers (a word that never '
                    'repeats a value, or a bit taken by fetch-and)',
                    'the operator, 2026-10-19: "marking them as overwritable at the moment it is known they have no '
                    'further consumers"')},
    'clock': {'C': ('C5', 'The operator\'s pair: lower, "synchronic temporal logic',
                    '{}: a clock reading or a *_NS bound deciding a branch within a call',
                    'within a call, the data or the platform deadline the only thing that ends a wait',
                    'the operator\'s pair, 2026-10-18: lower, "synchronic temporal logic (e.g. mutating somethin during '
                    'a call based on a timing estimate or measurement)"; upper, "diachronic temporal logic: allowed, '
                    'uses known buffer depth, effectively free if you pipeline it"; and ' + TIMING[14:]),
              'M': ('M8', 'Ranks higher: the form with fewer steps between',
                    '{}: a clock reading or a *_NS bound deciding a branch on the bridge\'s data path',
                    'the branch decided by the data', TIMING)},
    'sleep': {'C': ('C4', 'poll-then-park ≺ none', '{}: a sleep or a timed wait on the call\'s data path',
                    'the wait only on landed data', C4_PAIR),
              'M': ('M8', 'host groups that poll for 1 ms and then park ≺ no parking',
                    '{}: a sleep or a timed wait on the bridge\'s data path', 'no parking',
                    'the operator, 2026-10-18: the queues "spinqueried as FAST AS HARDWARE THREADS ALLOW on both sides '
                    'of each bridge"')},
    'seqcst': {'M': ('M8', '10ns of reducible overhead',
                     '{}: a sequentially consistent atomic on the per-unit path (a store then a load: the core waits '
                     'for the store to be seen; bridge audit 2026-10-22, item 4)', 'release and acquire', OVERHEAD)},
    'page': {'M': ('M8', '10ns of reducible overhead',
                   '{}: a unit\'s length the whole page (TN3205 matches frames, 4 KiB; bridge audit 2026-10-22, '
                   'item 1)', 'a unit of the plan\'s bytes', OVERHEAD)},
    'line': {'M': ('M8', '10ns of reducible overhead',
                   'struct {}: `{}` ({}) and `{}` ({}) on one {}-byte line, each writer\'s store taking the line from '
                   'the other (bridge audit 2026-10-22, item 3)', 'one writer a line', OVERHEAD)},
    'spin': {'C': ('C4', 'Lower pole: barriers, pauses, syncs', '{}: a spin inside a kernel other than the landing wait',
                   'the landing wait alone', 'the operator, 2026-10-21: "keep only the landing wait, one acquire '
                   'fence, a poll bound for the node"')},
    'error': {'C': ('C6', 'rejection filters ≺ none', '{}: an error word or a patience bound inside a kernel', 'none',
                    'the operator, 2026-10-20: "you are afaict lapsing into defensive programming and adding positive '
                    'features which induce waits, stalls, guards, hangs, and have no data flow or specification '
                    'articulating why these states must exist or how they will with 100% certainty exit a guarding or '
                    'waiting state."; 2026-10-22: "error states can be made unreachable and proven to be unreachable"'),
              'D': ('D3', 'Lower pole: escape hatches', '{}: an error word or a patience bound inside a kernel, a path '
                    'the kernel chooses on its own', 'control flow that differs only where a configuration says so',
                    'the operator, 2026-10-17: "why should control flow ever be different for any reason but \'a config '
                    'object asserting a different control flow was submitted\'?"; 2026-10-22: "error states can be '
                    'made unreachable and proven to be unreachable"')},
    'store': {k: (d, a, '{}: a plain store (`simdgroup_store`) into device memory in a publishing kernel, a second form '
                  'of the header\'s system-coherent write (the NIC reads a plain store only once its command buffer has '
                  'ended: metal-microbench docs/measurement.md, 2026-09-29)', 'the header\'s `mesh_step_write`', w)
