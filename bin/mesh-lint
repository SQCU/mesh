                                ('C', 'C9', 'a mandate to write a template 20 to 40 times', ONE_FORM_C))},
    'operand': {'D': ('D10', 'justifying something running slower',
                      '{}: a product\'s k-loop reading landed bytes system-coherent, once per column tile (GPU audit '
                      '2026-10-22: 30-45 us of an 89 us LSTM tick)', 'the operand staged once into threadgroup memory '
                      'and read there by every column tile (examples/lstm.metal Segments::fill; CUTLASS; Volkov and '
                      'Demmel, SC 2008)', 'the operator\'s pair: lower, "justifying something running slower than it '
                      'should"; upper, "no part of any model or eval we study may ever be slow" (2026-10-19)')},
    'sync': {'C': ('C4', 'Lower pole: barriers, pauses, syncs', '`{}` on the step loop\'s path: the host waits for the '
                   'GPU', 'nothing waited on between a submission\'s crossings',
                   'the operator, 2026-10-22: "algorithmically unjustified halts, waits"; ' + C4_PAIR)},
    'replan': {'D': ('D8', 'recomputing what a cache would hold', 'a crossing planned again every step (the library '
                     'plans, places and records it each call; host audit 2026-10-22, A.1)', 'the crossing presented '
                     'once and started each step, as MPI_Allreduce_init and MPI_Start',
                     'the operator, 2026-10-16: "caching and memoization are required"')},
    'pages': {'D': ('D7', 'Ranks higher: the form that knows less about links',
                    'data code reading a collective backend\'s page facts (page size, page rounding)',
                    'the buffer the collective\'s allocation gives',
                    'the operator, 2026-10-22: "data processing code may never discover these abstracted features"; '
                    '"information hiding from data processing code authors on some level must exist for performance '
                    'reasons and for decoupling backend complexity from linear algebraic function complexity rather '
                    'than for \'security\' or \'memory safety\'"')},
}

findings = []


def kind_of(path):
    try:
        rel = Path(path).resolve().relative_to(ROOT).as_posix()
    except ValueError:
        return None
    return next((k for k, pattern in KINDS if re.fullmatch(pattern, rel)), None)


def rubric_line(dimension, anchor):
    heading = next((i for i, s in enumerate(RUBRIC_LINES) if s.startswith(f'**{dimension}.')), 0)
    return next((i + 1 for i in range(heading, len(RUBRIC_LINES)) if anchor in RUBRIC_LINES[i]), heading + 1)


def find(path, line, form, *details):
    pair = EVIDENCE[form].get(kind_of(path))
    if pair:
        dimension, anchor, found, higher, words = pair
        findings.append((str(path), line, dimension, rubric_line(dimension, anchor), found.format(*details), higher,
                         words))


def strip_c(text):
    """Comments and string literals blanked, newlines kept, so line numbers hold."""
    out, i, n = [], 0, len(text)
    while i < n:
        if text.startswith('/*', i):
            j = text.find('*/', i + 2)
            j = n if j < 0 else j + 2
            out.append(re.sub(r'[^\n]', ' ', text[i:j]))
            i = j
        elif text.startswith('//', i):
            j = text.find('\n', i)
            j = n if j < 0 else j
            out.append(' ' * (j - i))
            i = j
        elif text[i] == '"' and (i == 0 or text[i - 1] != "'"):
            j = i + 1
            while j < n and text[j] != '"':
                j += 2 if text[j] == '\\' else 1
            out.append('"' + re.sub(r'[^\n]', ' ', text[i + 1:j]) + '"')
            i = j + 1
        else:
            out.append(text[i])
            i += 1
    return ''.join(out)


FUNCTION = re.compile(r'(?m)^[^\S\n]*(?:[\w:\[\]<>\*&,\s()]*?)\b([A-Za-z_]\w*)\s*\(([^;{}()]*(?:\([^;{}()]*\)[^;{}()]*)*)\)'
                      r'\s*(?:const\s*)?(?:thread\s*)?\{')
CONTROL = {'if', 'for', 'while', 'switch', 'return', 'sizeof', 'do', 'else', 'catch'}


def functions(clean):
    """(name, start line, body text, body start offset) of each function definition in C-like text."""
    for m in FUNCTION.finditer(clean):
        name = m.group(1)
        if name in CONTROL:
            continue
        start = m.end() - 1
        depth, j = 0, start
        while j < len(clean):
            if clean[j] == '{':
                depth += 1
            elif clean[j] == '}':
                depth -= 1
                if depth == 0:
                    break
            j += 1
        yield name, clean.count('\n', 0, m.start()) + 1, clean[start:j + 1], start


def line_of(clean, offset):
    return clean.count('\n', 0, offset) + 1


def conditions(ln):
    """The text of each if, while or for condition that opens on a line."""
    out = []
    for m in re.finditer(r'\b(?:if|while|for)\s*\(', ln):
        depth, j = 1, m.end()
        while j < len(ln) and depth:
            depth += {'(': 1, ')': -1}.get(ln[j], 0)
            j += 1
        out.append(ln[m.end():j])
    return ' '.join(out)


def check_c(path, text):
    clean = strip_c(text)
    rel = path.relative_to(ROOT).as_posix()
    path_re = DATA_PATH.get(rel)
    for name, _, body, at in functions(clean):
        if 'allAllocations' in body and 'useResource' in body:
            find(path, line_of(clean, at + body.index('allAllocations')), 'residency', name)
        for m in re.finditer(r'atomic_compare_exchange_\w+\(\s*&\s*([\w\[\]\.\->]+?)\s*,\s*&\s*(\w+)\s*,', body):
            word, expected = m.group(1), m.group(2)
            if re.search(r'atomic_store\w*\(\s*&\s*' + re.escape(word) + r'\s*,\s*' + re.escape(expected) + r'\s*[,)]', body[m.end():]):
                find(path, line_of(clean, at + m.start()), 'claim', name, expected)
    for m in re.finditer(r'IBV_QPS_RESET|IBV_QPS_ERR|ibv_destroy_qp|\bdestroy_qp\b', clean):
        find(path, line_of(clean, m.start()), 'qp')
    for name, _, body, at in functions(clean):
        on_path = path_re and re.fullmatch(path_re, name)
        per_unit = re.fullmatch(PER_UNIT, name)
        if not on_path:
            continue
        lines = body.split('\n')
        deadlines = set()
        for k, ln in enumerate(lines):
            if re.search(CLOCK, ln) or re.search(r'\b\w+_NS\b', ln):
                assigned = re.match(r'\s*(?:const\s+)?(?:uint64_t|uint32_t|int64_t|double|auto)?\s*(\w+)\s*=', ln)
                if re.search(r'[^<>\-]([<>]=?)[^<>]', ln) and not re.search(r'#include|->', ln.split('?')[0] if '?' in ln else ''):
                    find(path, line_of(clean, at) + k, 'clock', name)
                elif assigned:
                    deadlines.add(assigned.group(1))
            for d in deadlines:
                if re.search(rf'\b{d}\b', conditions(ln)):
                    find(path, line_of(clean, at) + k, 'clock', f'{name}, `{d}`')
            if re.search(TIMED_WAIT, ln):
                find(path, line_of(clean, at) + k, 'sleep', name)
            if per_unit and re.search(r'memory_order_seq_cst|__ATOMIC_SEQ_CST', ln):
                find(path, line_of(clean, at) + k, 'seqcst', name)
            if name in ('lane_send', 'lane_post', 'page_span') and 'page_bytes()' in ln:
                find(path, line_of(clean, at) + k, 'page', name)


LANDED = r'\b(?:mesh_step_read|mesh_payload)\b'


def readers_of(paths):
    """Names of the Metal functions that read landed bytes (mesh_step_read, mesh_payload), over every .metal file of the
    run: a product in one file reaches a loader in another by name."""
    return {name for p in paths if p.suffix == '.metal'
            for name, _, body, _ in functions(strip_c(p.read_text(errors='replace'))) if re.search(LANDED, body)}


def check_metal(path, text, readers=frozenset()):
    clean = strip_c(text)
    publishing = 'mesh_step_release' in clean
    threadgroup_names = set(re.findall(r'threadgroup\s+[\w:<>\s]+?\b(\w+)\s*\[', clean))
    reads = re.compile(r'\b(?:mesh_step_read|mesh_payload' + ''.join('|' + re.escape(r) for r in sorted(readers)) + r')\s*[<(]')
    for name, _, body, at in functions(clean):
        lines = body.split('\n')
        if 'simdgroup_multiply_accumulate' in body:
            for k, ln in enumerate(lines):
                if reads.search(ln):
                    find(path, line_of(clean, at) + k, 'operand', name)
        spin_at = next((i for i, ln in enumerate(lines) if re.search(r'\bfor\s*\([^;]*;\s*;|\bwhile\s*\(', ln)), None)
        if spin_at is not None and re.search(r'atomic_load_explicit|coherent\(system\)', body) and name not in LANDING_WAITS:
            find(path, line_of(clean, at) + spin_at, 'spin', name)
        for k, ln in enumerate(lines):
            if re.search(r'\bPATIENCE\b|atomic_fetch_or_explicit\(\s*err\b|\b(stop|err)\s*,\s*1u\b', ln):
                find(path, line_of(clean, at) + k, 'error', name)
            m = re.search(r'simdgroup_store\(\s*\w+\s*,\s*(\w+)', ln)
            if publishing and m and m.group(1) not in threadgroup_names:
                find(path, line_of(clean, at) + k, 'store', name)
            if re.search(r'\.d\s*\+', ln) and 'mesh_step_read' not in ln:
                find(path, line_of(clean, at) + k, 'land', name)


def check_python(path, text):
    try:
        tree = ast.parse(text)
    except SyntaxError:
        return
    defs = {n.name: n for n in ast.walk(tree) if isinstance(n, ast.FunctionDef)}

    def calls(node):
        return [c for c in ast.walk(node) if isinstance(c, ast.Call)]

    def callee(c):
        f = c.func
        return f.attr if isinstance(f, ast.Attribute) else f.id if isinstance(f, ast.Name) else ''

    def is_step_loop(loop):
        return any(callee(c) in ('exchange', 'encode', 'step', 'tick', 'chain_stream', 'lstm_stream') for c in calls(loop)) or \
            any(isinstance(c.func, ast.Name) and c.func.id in ('step', 'tick') for c in calls(loop))

    def syncs(node, seen):
        for c in calls(node):
            name = callee(c)
            blocking_copy = name == 'copy_' and not any(k.arg == 'non_blocking' for k in c.keywords)
            if name in ('synchronize', 'item', 'cpu', 'tolist', 'barrier') or blocking_copy:
                yield c, name
            if name in defs and name not in seen:
                seen.add(name)
                yield from syncs(defs[name], seen)

    for loop in [n for n in ast.walk(tree) if isinstance(n, (ast.For, ast.While))]:
        if is_step_loop(loop):
            for c, name in syncs(loop, set()):
                find(path, c.lineno, 'sync', name)
    for fn in [n for n in ast.walk(tree) if isinstance(n, ast.FunctionDef) and n.name in ('__call__', 'step', 'tick')]:
        for c in calls(fn):
            if callee(c) == 'exchange':
                find(path, c.lineno, 'replan')
    if '/examples/' in str(path) or path.name in ('chain.py', 'lstm.py'):
        for node in ast.walk(tree):
            if (isinstance(node, ast.Attribute) and node.attr in ('getpagesize', 'PAGE', 'paged')) or \
                    (isinstance(node, ast.Name) and node.id in ('PAGE', 'paged')):
                find(path, node.lineno, 'pages')


def check_lines():
    """Shared words with different writers on one cache line, from a compiled offsetof probe."""
    line = int(subprocess.run(['sysctl', '-n', 'hw.cachelinesize'], capture_output=True, text=True).stdout or 128)
    probe = ['#include <stdio.h>', '#include <stddef.h>', '#include "mesh-bridge.h"', 'int main(void){']
    for struct, fields in WRITERS.items():
        for f in fields:
            probe.append(f'printf("{struct} {f} %zu\\n",offsetof(struct {struct},{f}));')
    probe.append('return 0;}')
    with tempfile.TemporaryDirectory() as d:
        src, exe = Path(d) / 'probe.c', Path(d) / 'probe'
        src.write_text('\n'.join(probe))
        made = subprocess.run(['cc', '-I', str(RDMA), '-o', str(exe), str(src)], capture_output=True, text=True)
        if made.returncode:
            print('mesh-lint: the offsetof probe did not compile: ' + made.stderr.strip()[:200], file=sys.stderr)
            return
        out = subprocess.run([str(exe)], capture_output=True, text=True).stdout.split('\n')
    at = {}
    for row in filter(None, out):
        struct, field, offset = row.split()
        at[(struct, field)] = int(offset)
    for struct, fields in WRITERS.items():
        header = RDMA / ('mesh.h' if struct == 'mesh_stream' else 'mesh-bridge.h')
        number = next((i + 1 for i, s in enumerate(header.read_text().split('\n')) if f'struct {struct} {{' in s), 1)
        names = list(fields)
        for i, a in enumerate(names):
            for b in names[i + 1:]:
                if fields[a] != fields[b] and at[(struct, a)] // line == at[(struct, b)] // line:
                    find(header, number, 'line', struct, a, fields[a], b, fields[b], line)


def cited(dimension, words):
    """The rubric line of the first of the operator's words a finding quotes; 0 where any quoted words are not the
    rubric's."""
    quotes = [re.sub(r'\s+', ' ', q).strip() for q in re.findall(r'"([^"]{8,})"', words)]
    if not quotes or any(q not in RUBRIC_FLAT for q in quotes):
        return 0
    head = ' '.join(quotes[0].split()[:4])
    return next((i + 1 for i, s in enumerate(RUBRIC_LINES) if head in s), rubric_line(dimension, '\0'))


def semantic(units):
    """Each unit read by a model against design/rubrics.md, by its file's kind's dimensions."""
    claude = shutil.which('claude')
    if not claude:
        print('mesh-lint: no `claude` command: --semantic did not run', file=sys.stderr)
        return
    cache_path = RDMA / '.build' / 'mesh-lint-cache.json'
    cache = json.loads(cache_path.read_text()) if cache_path.exists() else {}
    schema = json.dumps({'type': 'object', 'properties': {'findings': {'type': 'array', 'items': {
        'type': 'object', 'properties': {'line': {'type': 'integer'}, 'dimension': {'type': 'string'},
                                         'found': {'type': 'string'}, 'higher': {'type': 'string'},
                                         'words': {'type': 'string'}},
        'required': ['line', 'dimension', 'found', 'higher', 'words']}}}, 'required': ['findings']})

    def key(unit):
        path, first, name, code = unit
        return hashlib.sha256((RUBRIC_TEXT + str(kind_of(path)) + code).encode()).hexdigest()

    def ask(unit):
        path, first, name, code = unit
        if key(unit) in cache:
            return unit, cache[key(unit)]
        kind = kind_of(path)
        numbered = '\n'.join(f'{first + i}: {ln}' for i, ln in enumerate(code.split('\n')))
        prompt = (f'{RUBRIC_TEXT}\n\nAbove is design/rubrics.md. The function `{name}` below, from '
                  f'{os.path.relpath(path, ROOT)}, is {KIND_NAMES[kind]} code ({kind}); each line is prefixed with its '
                  f'line number in the file. Rank its forms by the {kind} dimensions and the Quantities only. Report a '
                  f'line only where a dimension ranks the form written there below another form and the rubric quotes '
                  f'the operator\'s words that make that pair the operator\'s judgement. `line` is the line number, '
                  f'`dimension` the dimension\'s id (such as {kind}4), `found` the form written at that line, `higher` '
                  f'the form the dimension ranks above it, and `words` the operator\'s words, copied verbatim from the '
                  f'rubric in double quotes, with their date. Report nothing the rubric does not rank, and nothing you '
                  f'cannot point to by line.\n\n```\n{numbered}\n```')
        run = subprocess.run([claude, '-p', '--model', 'haiku', '--output-format', 'json', '--json-schema', schema, prompt],
                             capture_output=True, text=True, timeout=600, stdin=subprocess.DEVNULL)
        try:
            out = json.loads(run.stdout)
            return unit, out.get('structured_output') or json.loads(out.get('result') or '{}')
        except (ValueError, TypeError):
            print(f'mesh-lint: {path}:{first}: the model call failed: ' + run.stderr[:200], file=sys.stderr)
            return unit, None

    with concurrent.futures.ThreadPoolExecutor(8) as pool:
        for unit, result in pool.map(ask, units):
            if result is None:
                continue
            path, first, name, code = unit
            cache[key(unit)] = result
            for f in result.get('findings', []):
                at = cited(f['dimension'], f['words'])
                if at:
                    findings.append((str(path), int(f['line']), f['dimension'], at, f'{name}: ' + f['found'],
                                     f['higher'], f['words']))
    cache_path.parent.mkdir(exist_ok=True)
    cache_path.write_text(json.dumps(cache))


def units_of(paths):
    for path in paths:
        if path.suffix in ('.c', '.m', '.mm', '.metal', '.h') and kind_of(path):
            text = path.read_text(errors='replace')
            clean = strip_c(text)
            rel = path.relative_to(ROOT).as_posix()
            pattern = DATA_PATH.get(rel)
            for name, first, body, at in functions(clean):
                if path.suffix == '.metal' or (pattern and re.fullmatch(pattern, name)):
                    start = line_of(clean, at)
                    yield path, first, name, '\n'.join(text.split('\n')[first - 1:start + body.count('\n')])


def sources(given):
    if given:
        return [Path(p).resolve() for p in given]
    found = []
    for pattern in ('rdma/*.c', 'rdma/*.m', 'rdma/*.h', 'rdma/*.metal', 'rdma/torch-mesh/torch_mesh/*.mm',
                    'rdma/torch-mesh/torch_mesh/*.metal', 'rdma/torch-mesh/torch_mesh/*.py', 'examples/*.metal',
                    'examples/*.py'):
        found.extend(sorted(ROOT.glob(pattern)))
    return found


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('paths', nargs='*')
    parser.add_argument('--semantic', action='store_true', help='also ask a model about each data-path function')
    parser.add_argument('--strict', action='store_true', help='exit 1 on any finding')
    args = parser.parse_args()
    paths = sources(args.paths)
    readers = readers_of(paths)
    for path in paths:
        text = path.read_text(errors='replace')
        if path.suffix in ('.c', '.m', '.mm', '.h'):
            check_c(path, text)
        elif path.suffix == '.metal':
            check_metal(path, text, readers)
        elif path.suffix == '.py':
            check_python(path, text)
    if not args.paths:
        check_lines()
    if args.semantic:
        semantic(list(units_of(paths)))
    for path, line, dimension, at, found, higher, words in sorted(set(findings)):
        print(f'{os.path.relpath(path, Path.cwd())}:{line}: {dimension} (design/rubrics.md:{at}): {found} ≺ {higher}')
        print(f'    {words}')
    print(f'mesh-lint: {len(set(findings))} findings', file=sys.stderr)
    sys.exit(1 if args.strict and findings else 0)


if __name__ == '__main__':
    main()
