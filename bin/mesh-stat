#!/bin/sh
owner=$(cat /usr/local/mesh/admin-user 2>/dev/null); me=$(id -un)
[ -n "$owner" ] || owner=$me
[ "$me" = root ] || [ "$me" = "$owner" ] || { printf '{"up":false,"errno":1}\n'; exit 0; }
pid=$(/usr/bin/pgrep -nx -U "$owner" mesh-flow)
[ -n "$pid" ] || { printf '{"up":false,"errno":3}\n'; exit 0; }
bridge=$(/bin/ps -o comm= -p "$pid"); reader=${bridge%/*}/mesh-stat
{ [ -x "$reader" ] && [ ! "$reader" -ef "$0" ] && [ "$(/usr/bin/stat -f %Su "$reader")" = "$owner" ]; } || { printf '{"up":false,"errno":2}\n'; exit 0; }
[ "$me" = "$owner" ] || exec /usr/bin/sudo -n -u "$owner" "$reader" "$@"
exec "$reader" "$@"
