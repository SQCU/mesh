#!/bin/sh
mesh_repo=$(cd "$(dirname "$0")/.." && pwd)
mesh_build=${Q3MAP2_BUILD_ROOT:-$mesh_repo/.build/netradiant}
for mesh_compiler in "$mesh_build/current/install/q3map2" "$mesh_repo/xonotic/netradiant-custom/install/q3map2" "${HOME:-}/dox/xonotic/netradiant-custom/install/q3map2"; do
  [ -x "$mesh_compiler" ] && exec "$mesh_compiler" "$@"
done
bash "$mesh_repo/bin/mesh-q3map2-build.sh"
exec "$mesh_build/current/install/q3map2" "$@"
