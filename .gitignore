.DS_Store
*.log
networks.conf
rdma/mesh-flow
rdma/mesh-hop
rdma/qcaps
rdma/qfill
.claude/*
!.claude/settings.json
xonotic/bridge/test/meshtest
__pycache__/
xonotic/payload-build/run*/
xonotic/payload-build/.tmp/
xonotic/payload-build/extract/
xonotic/payload-build/userdir/

# QC build output. `xonotic/payload/build.sh` is the ONE writer and its
# destination is xonotic/payload-build; invoking `make -C qcsrc` directly writes
# these instead, which is how a fifth progs.dat appeared.
xonotic/progs.dat
xonotic/csprogs.dat
xonotic/menu.dat
xonotic/*.lno

# BUILT PROGRAMS ARE NOT SOURCE. One writer (xonotic/payload/build.sh), one
# destination (xonotic/payload-build), never committed. Tracking a build output
# is what let five progs.dat coexist and made stale ones look authoritative to
# the next reader -- see design/AGENDA.md R36.
xonotic/payload-build/
# Captured runtime home directories. A client's userdir (client.db, server.db,
# darkplaces_history.txt, demos) is a RECORDING of a run, not a component of the
# program; committing one makes a past execution look like a buildable variant.
xonotic/render/*-home/
# Stock Quake data + its compiled progs, for the qcbench fixture.
xonotic/qcbench/id1/
