{
  "scalar_types": {
    "FLOAT16": "half",
    "FLOAT32": "float",
    "FLOAT64": "double",
    "BFLOAT16": "bfloat",
    "INT8": "char",
    "UINT8": "uchar",
    "INT32": "int",
    "UINT32": "uint",
    "INT64": "long",
    "UINT64": "ulong"
  },
  "reduction": {
    "input": "contiguous",
    "output": "contiguous"
  },
  "matrix": {
    "input": "strided",
    "weight": "strided",
    "output": "indexed",
    "bias": "indexed"
  },
  "cpu_matrix": {
    "input": "positive_strided",
    "weight": "positive_strided",
    "output": "positive_strided"
  },
  "graph_operands": {
    "aten::mm": {"api": "matrix", "inputs": {"self": "input", "mat2": "weight"}, "output": "output"},
    "aten::bmm": {"api": "matrix", "inputs": {"self": "input", "mat2": "weight"}, "output": "output"},
    "aten::addmm": {"api": "matrix", "inputs": {"self": "bias", "mat1": "input", "mat2": "weight"}, "output": "output"},
    "torch_mesh::linear": {"api": "matrix", "inputs": {"x": "input", "w": "weight", "bias": "bias", "x1": "input"}, "permutations": {"w": [1, 0]}, "output": "output"},
    "torch_mesh::linears": {"api": "matrix", "inputs": {"x": "input", "w": "weight", "bias": "bias", "x1": "input"}, "permutations": {"w": [1, 0]}, "output": "output"}
  }
}
