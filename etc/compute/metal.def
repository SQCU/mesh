// Build-time Metal capabilities and initial compilation policy. This file is
// consumed by the native recorder, FX compiler, Swift engine and Metal source.
// Values are explicit operands, not facts to repeat in an algorithm.
// Hardware/ABI: Apple Metal feature tables and the recorder's access-word ABI.
MESH_METAL_VALUE(BUFFER_BINDINGS, 31)
MESH_METAL_VALUE(MEMORY_BINDINGS, 31)
MESH_METAL_VALUE(INDIRECT_COMMANDS, 4194304)
MESH_METAL_VALUE(SIMD_WIDTH, 32)
MESH_METAL_VALUE(ACCESS_WRITE_SHIFT, 32)
MESH_METAL_VALUE(REPLAY_BYTES, 32)
MESH_METAL_VALUE(REPLAY_ALIGNMENT, 32)
MESH_METAL_VALUE(SYSTEM_THREAD_SCOPE, 3)
MESH_METAL_VALUE(POLL_LIMIT, 4500000)
MESH_METAL_VALUE(STOP_POLL_PERIOD, 1024)
// Linear geometry: initial choices, not limits on the function's row count.
MESH_METAL_VALUE(LINEAR_ROWS, 8)
MESH_METAL_VALUE(LINEAR_COLUMNS, 2)
MESH_METAL_VALUE(LINEAR_LOADS, 2)
MESH_METAL_VALUE(LINEAR_VECTOR, 4)
MESH_METAL_VALUE(LINEAR_SIMDGROUPS, 8)
MESH_METAL_VALUE(LINEAR_GROUPS_PER_CORE, 256)
MESH_METAL_VALUE(LINEAR_MIN_INNER, 1024)
MESH_METAL_VALUE(LINEAR_ROW_CROSSOVER, 8)
// Cooperative matrix geometry: each SIMD group computes one tile.
MESH_METAL_VALUE(MATRIX_ROWS, 32)
MESH_METAL_VALUE(MATRIX_COLUMNS, 32)
MESH_METAL_VALUE(MATRIX_INNER, 32)
MESH_METAL_VALUE(MATRIX_ROW_GROUPS, 2)
MESH_METAL_VALUE(MATRIX_COLUMN_GROUPS, 2)
MESH_METAL_VALUE(FORMAT_ROWS, 32)
MESH_METAL_VALUE(FORMAT_COLUMNS, 64)
MESH_METAL_VALUE(FORMAT_INNER, 32)
MESH_METAL_VALUE(FORMAT_ROW_GROUPS, 2)
MESH_METAL_VALUE(FORMAT_COLUMN_GROUPS, 2)
// Copy/fold preparation. Work is distributed over the discovered GPU cores.
MESH_METAL_VALUE(GATHER_THREADS, 256)
MESH_METAL_VALUE(GATHER_ELEMENTS_PER_THREAD, 8)
MESH_METAL_VALUE(GATHER_GROUPS_PER_CORE, 1)
// Maximum logical bytes of one prepared layout-copy dependency tile.
// This is scheduling policy, not a limit on operand or function size.
MESH_METAL_VALUE(LAYOUT_COPY_TILE_BYTES, 262144)
// Preferred Hadamard block; graph construction factors larger rows into blocks.
// Workspace is specialized to the chosen width within the live memory limit.
MESH_METAL_VALUE(FWHT_BLOCK_WIDTH, 4096)
MESH_METAL_VALUE(FWHT_TILE_ELEMENTS, 4096)
MESH_METAL_VALUE(HADAMARD_THREADS, 256)
MESH_METAL_VALUE(HADAMARD_STORES, 16)
MESH_METAL_VALUE(HADAMARD_VALUES, 4)
MESH_METAL_VALUE(HADAMARD_BLOCKS, 3)
MESH_METAL_VALUE(HADAMARD_MIX, 20)
MESH_METAL_VALUE(HADAMARD_MIX_ROWS, 10)
MESH_METAL_VALUE(HADAMARD_STORAGE, 5120)

// Existing two-matrix attention page format. A different layout needs its compiled kernel.
MESH_METAL_VALUE(ATTENTION_TILE_PAGE, 16)
MESH_METAL_VALUE(SPEC_THREADS, 1024)
MESH_METAL_VALUE(DRAW_THREADS, 256)
MESH_METAL_VALUE(DRAW_MAX_BLOCKS, 256)
MESH_METAL_VALUE(DRAW_COLUMNS_PER_BLOCK, 2048)
MESH_METAL_VALUE(SELECTION_THREADS, 128)
MESH_METAL_VALUE(SCAN_THREADS, 256)
MESH_METAL_VALUE(POINTWISE_THREADS, 256)
// Head reductions cache only this many value pairs per lane. Larger heads
// stream their page operands; this budget does not limit the head's width.
MESH_METAL_VALUE(HEAD_THREADS, 128)
MESH_METAL_VALUE(HEAD_REGISTER_PAIRS, 4)

// Transport and prepared-command geometry, shared by both Metal command forms.
MESH_METAL_VALUE(TRANSPORT_GROUP_THREADS, 1024)
MESH_METAL_VALUE(TRANSPORT_ELEMENT_THREADS, 256)
MESH_METAL_VALUE(TRANSPORT_GRID_THREADS, 1048576)
MESH_METAL_VALUE(COMMAND_DATA_BYTES, 65536)
MESH_METAL_VALUE(COMMAND_DATA_ALIGNMENT, 16)
// Selection scratch layout and retained-logit policy.
MESH_METAL_VALUE(SELECTION_RADIX_BITS, 8)
MESH_METAL_VALUE(SELECTION_STATE_WORDS, 4)
MESH_METAL_VALUE(KEPT_HEAD, 64)
MESH_METAL_VALUE(KEPT_TAIL, 64)

// Existing packed-weight tile layout and the backend's compiled panel launch.
MESH_METAL_VALUE(WEIGHT_ROW_GROUP, 32)
// Coded-weight words: shared by the decoder and preparation's access views.
MESH_METAL_VALUE(STREAMED_BAND_BASE_MASK, 268435455)
MESH_METAL_VALUE(STREAMED_SLAB_SHIFT, 28)
MESH_METAL_VALUE(STREAMED_TILE_OFFSET_MASK, 4095)
MESH_METAL_VALUE(STREAMED_TILE_WIDTH_SHIFT, 12)
MESH_METAL_VALUE(STREAMED_TILE_WIDTH_MASK, 15)
MESH_METAL_VALUE(STREAMED_PLANE_WORDS, 32)
MESH_METAL_VALUE(STREAMED_LUT_ENTRIES, 128)
MESH_METAL_VALUE(STREAMED_PANEL_TILES, 8)
MESH_METAL_VALUE(STREAMED_RING_PADDING, 8)
MESH_METAL_VALUE(STREAMED_SCALE_THREADS, 256)
MESH_METAL_VALUE(COOPERATIVE_MIN_ROWS, 8)
MESH_METAL_VALUE(COOPERATIVE_MAX_ROWS, 64)
MESH_METAL_VALUE(PREFILL_MASK_LANES, 64)
MESH_METAL_VALUE(SPEC_HISTORY_PADDING, 64)
MESH_METAL_VALUE(FORMAT_INPUT_SCALAR, 1)
MESH_METAL_VALUE(FORMAT_WEIGHT_SCALAR, 2)
