{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "statusMessage": "Warnings from the records of new commits",
            "async": true,
            "command": "/opt/homebrew/bin/python3 /Users/mdot/dox/mesh/bin/mesh-told.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task|SendMessage|Workflow",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "/opt/homebrew/bin/python3 /Users/mdot/dox/mesh/bin/mesh-brief-gate.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "/opt/homebrew/bin/python3 /Users/mdot/dox/mesh/bin/mesh-agent-mark.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 150,
            "command": "/opt/homebrew/bin/python3 /Users/mdot/dox/mesh/bin/mesh-stop.py"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 150,
            "command": "/opt/homebrew/bin/python3 /Users/mdot/dox/mesh/bin/mesh-stop.py"
          }
        ]
      }
    ]
  }
}
