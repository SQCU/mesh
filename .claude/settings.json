{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *commit*)",
            "timeout": 180,
            "statusMessage": "C9 review of the commit",
            "command": "/opt/homebrew/bin/python3 /Users/mdot/dox/mesh/bin/mesh-c9-review.py"
          },
          {
            "type": "command",
            "if": "Bash(git *commit*)",
            "timeout": 1200,
            "statusMessage": "Change-request review of the commit",
            "command": "/opt/homebrew/bin/python3 /Users/mdot/dox/mesh/bin/mesh-cr-review.py"
          }
        ]
      }
    ]
  }
}
