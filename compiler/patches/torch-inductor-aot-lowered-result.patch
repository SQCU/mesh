+    """
+    compiler/patches/torch-inductor-aot-lowered-result.patch: aot_inductor.lowered, the compile-time intrinsic of a
+    selected non-Triton kernel's call (KernelCallLine.triton False) in the lowered result's converted graph,
+    selected_kernel_call(kernel_name, *operands, **call_kwargs) -> None: `kernel_name` its kernel (its definition
+    FxConverter.definitions'), `operands` and `call_kwargs` the call's own (KernelCallLine.operands, .call_kwargs) as
+    graph values. Registered as the print HOP (_higher_order_ops/print.py) is, a value-less effect: its fake
+    (register_fake, None, so _node_metadata_hook's meta["val"] None), the fallthrough of its fake operands' autograd
+    keys (cpu, mps) and has_side_effect (Node.is_impure), so dead code elimination keeps it. Its effect is its writes
+    to its operand buffers (cpu: KernelArgs' in-place and output buffers; mps: its output buffers); the lowered
+    result's consumer compiles and calls the kernel. It has no backend kernel: the converted graph is the lowered
+    result, never run as a module (an ordinary fx_wrapper's non-Triton call is upstream's, _generate_kernel_call).
+    """
+
+    def __init__(self) -> None:
+        super().__init__("selected_kernel_call")
+
+    def __call__(self, kernel_name: str, *operands: Any, **call_kwargs: Any) -> None:
+        return super().__call__(kernel_name, *operands, **call_kwargs)
+
+
