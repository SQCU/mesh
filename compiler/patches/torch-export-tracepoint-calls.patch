+
+class CollectTracepointsPass(PassBase):
+    """
+    Performs constant folding and constant propagation.
+    """
+
+    def __init__(self) -> None:
+        super().__init__()
+        # mesh compiler/patches/torch-export-tracepoint-calls.patch: torch/export/_trace.py _get_module_call_graph;
+        # torch/fx/graph.py Graph.erase_node
+        self.markers: list[tuple[torch.fx.GraphModule, torch.fx.Node, tuple]] = []
+        self.occurrences: list[list] = []
+        self.replaced: list[tuple[torch.fx.Node, torch.fx.Node]] = []
+
+    def call(self, gm: torch.fx.GraphModule) -> PassResult | None:
+        for module in gm.modules():
+            if not isinstance(module, torch.fx.GraphModule):
+                continue
+            nn_module_stack = None
+            for node in module.graph.nodes:
+                if node.op != "call_function":
+                    continue
+                if node.target is torch.ops.higher_order._export_tracepoint:
+                    kind = node.kwargs["kind"]
+                    if kind == "module_call_outputs":
+                        nn_module_stack = node.meta["nn_module_stack"]
+                    elif kind == "module_call_inputs":
+                        nn_module_stack = None
+                    else:
+                        raise AssertionError(f"Unknown tracepoint kind: {kind}")
+                # mesh compiler/patches/torch-export-tracepoint-calls.patch: torch/_functorch/_aot_autograd/utils.py 603–647
+                elif nn_module_stack is not None and node.meta.get("nn_module_stack") == nn_module_stack:
+                    node.meta["nn_module_stack"].popitem()
+                else:
+                    nn_module_stack = None
+            nn_module_stack = None
+            for node in reversed(module.graph.nodes):
+                if node.op != "call_function":
+                    continue
+                if node.target is torch.ops.higher_order._export_tracepoint:
+                    kind = node.kwargs["kind"]
+                    if kind == "module_call_inputs":
+                        nn_module_stack = node.meta["nn_module_stack"]
+                    elif kind == "module_call_outputs":
+                        nn_module_stack = None
+                    else:
+                        raise AssertionError(f"Unknown tracepoint kind: {kind}")
+                # mesh compiler/patches/torch-export-tracepoint-calls.patch: torch/_functorch/_aot_autograd/utils.py 603–647
+                elif nn_module_stack is not None and node.meta.get("nn_module_stack") == nn_module_stack:
+                    node.meta["nn_module_stack"].popitem()
+                else:
+                    nn_module_stack = None
+
+        for module in gm.modules():
+            if not isinstance(module, torch.fx.GraphModule):
+                continue
+            opened: dict[str, list[list]] = {}
+            for node in module.graph.nodes:
+                if node.op != "call_function":
+                    continue
+                if node.target is torch.ops.higher_order._export_tracepoint:
+                    marker = (module, node, node.args)
+                    self.markers.append(marker)
+                    if node.kwargs["kind"] == "module_call_inputs":
+                        self.occurrences.append([marker, None])
+                        opened.setdefault(node.kwargs["path"], []).append(self.occurrences[-1])
+                    else:
+                        opened[node.kwargs["path"]].pop()[1] = marker
+                    for i, arg in enumerate(node.args):
+                        if isinstance(arg, torch.fx.Node):
+                            for user in node.users:
+                                if user.op != "call_function":
+                                    raise AssertionError(
+                                        f"expected call_function, got {user.op}"
+                                    )
+                                if user.target is not operator.getitem:
+                                    raise AssertionError(
+                                        f"expected getitem target, got {user.target}"
+                                    )
+                                if not isinstance(user.args[1], int):
+                                    raise AssertionError(
+                                        f"expected int arg, got {type(user.args[1])}"
+                                    )
+                                if user.args[1] == i:
+                                    user.replace_all_uses_with(arg)
+                                    self.replaced.append((user, arg))
+                                    break
+                    users = list(node.users)
+                    for user in users:
+                        if len(user.users) != 0:
+                            raise AssertionError(
+                                f"expected no users, got {len(user.users)}"
+                            )
+                        module.graph.erase_node(user)
+                    module.graph.erase_node(node)
+        return PassResult(gm, True)
